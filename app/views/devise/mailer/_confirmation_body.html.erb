<tr>
  <td align="center" style="padding: 0 0 14px; text-align: center;">
    <span style="display: inline-block; padding: 6px 16px; border-radius: 999px; background-color: #EFF6FF; border: 1px solid #DBEAFE; color: #2563EB; font-size: 11px; line-height: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
      <%= eyebrow %>
    </span>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 0 0 16px; text-align: center;">
    <h1 style="margin: 0; font-size: 28px; line-height: 34px; font-weight: 800; color: #0F172A; letter-spacing: -0.02em;"><%= heading %></h1>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 10px;">
    <p style="margin: 0; font-size: 15px; line-height: 22px; font-weight: 600; color: #0F172A;">Hi <%= recipient_name %>,</p>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 10px;">
    <p style="margin: 0; font-size: 14px; line-height: 22px; color: #475569;"><%= intro_text %></p>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 <%= detail_rows.any? || info_title.present? ? '16px' : '24px' %>;">
    <p style="margin: 0; font-size: 14px; line-height: 22px; color: #475569;"><%= supporting_text %></p>
  </td>
</tr>
<% if detail_rows.any? %>
  <tr>
    <td style="padding: 0 0 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width: 100%; border: 1px solid #E2E8F0; border-radius: 16px; background-color: #F8FAFC;">
        <% detail_rows.each_with_index do |(label, value), index| %>
          <tr>
            <td style="padding: 16px 20px;<%= ' border-top: 1px solid #E2E8F0;' unless index.zero? %>">
              <p style="margin: 0 0 4px; font-size: 11px; line-height: 14px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #64748B;">
                <%= label %>
              </p>
              <p style="margin: 0; font-size: 14px; line-height: 21px; font-weight: 600; color: #0F172A;"><%= value %></p>
            </td>
          </tr>
        <% end %>
      </table>
    </td>
  </tr>
<% end %>
<% if action_url.present? %>
  <tr>
    <td style="padding: 0 0 24px;" align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0;">
        <tr>
          <td align="center" bgcolor="#2563EB" style="border-radius: 14px; background-color: #2563EB; background: linear-gradient(135deg, #2563EB 0%, #7C3AED 100%); box-shadow: 0 8px 20px -4px rgba(37, 99, 235, 0.4);">
            <%= link_to(
              action_text,
              action_url,
              style: 'display:block; width:100%; box-sizing:border-box; padding:14px 28px; font-size:15px; line-height:20px; font-weight:700; color:#FFFFFF; text-align:center; text-decoration:none; border-radius:14px;'
            ) %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding: 0 0 20px;">
      <p style="margin: 0; font-size: 13px; line-height: 20px; color: #64748B;">
        If the button above does not work, copy and paste this secure URL into your browser:
        <br />
        <%= link_to(
          action_url,
          action_url,
          style: 'color:#2563EB; text-decoration:underline; font-weight:500; word-break:break-all;'
        ) %>
      </p>
    </td>
  </tr>
<% elsif info_title.present? %>
  <tr>
    <td style="padding: 0 0 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width: 100%; border: 1px solid #DBEAFE; border-radius: 16px; background-color: #EFF6FF;">
        <tr>
          <td style="padding: 18px 20px;">
            <p style="margin: 0 0 6px; font-size: 14px; line-height: 20px; font-weight: 700; color: #1E40AF;">
              <%= info_title %>
            </p>
            <p style="margin: 0; font-size: 14px; line-height: 21px; color: #3B82F6;"><%= info_text %></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
<% end %>


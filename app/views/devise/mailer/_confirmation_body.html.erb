<%
  @email_heading = heading
  @email_subtitle = eyebrow
  @email_icon = local_assigns[:icon].presence || 'mail'
  content_for :email_heading, heading
  content_for :email_subtitle, eyebrow
  content_for :email_icon, @email_icon
%>

<p style="margin: 0 0 10px; font-size: 13px; line-height: 20px; font-weight: 600; color: #0F172A;">Hi <%= recipient_name %>,</p>
<p style="margin: 0 0 10px; font-size: 13px; line-height: 20px; color: #334155;"><%= intro_text %></p>
<p style="margin: 0 0 16px; font-size: 13px; line-height: 20px; color: #334155;"><%= supporting_text %></p>

<% if detail_rows.any? %>
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 18px;">
    <% detail_rows.each do |(label, value)| %>
      <tr>
        <td style="padding: 9px 0; font-size: 13px; font-weight: 600; color: #334155;"><%= label %></td>
        <td align="right" style="padding: 9px 0; font-size: 14px; font-weight: 800; color: #0F172A;"><%= value %></td>
      </tr>
    <% end %>
  </table>
<% end %>

<% if action_url.present? %>
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F9FAFB; border: 1.5px dashed #CBD5E1; border-radius: 12px; margin-bottom: 16px;">
    <tr>
      <td align="center" style="padding: 18px 16px;">
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.5px; margin-bottom: 12px;">
          Continue with this secure link
        </div>
        <%= link_to(
          action_text,
          action_url,
          style: 'display: inline-block; background-color: #5551FF; color: #FFFFFF; font-size: 13px; font-weight: 700; text-decoration: none; padding: 10px 22px; border-radius: 7px;'
        ) %>
        <p style="margin: 12px 0 0; font-size: 12px; line-height: 18px; color: #64748B; word-break: break-all;">
          If the button does not work, copy this URL:<br />
          <%= link_to(action_url, action_url, style: 'color: #4338CA; font-weight: 600; text-decoration: none; overflow-wrap: anywhere; word-break: break-word;') %>
        </p>
      </td>
    </tr>
  </table>
<% elsif info_title.present? %>
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F9FAFB; border: 1.5px dashed #CBD5E1; border-radius: 12px; margin-bottom: 16px;">
    <tr>
      <td style="padding: 18px 16px;">
        <p style="margin: 0 0 6px; font-size: 14px; font-weight: 700; color: #0F172A;"><%= info_title %></p>
        <p style="margin: 0; font-size: 13px; line-height: 20px; color: #334155;"><%= info_text %></p>
      </td>
    </tr>
  </table>
<% end %>

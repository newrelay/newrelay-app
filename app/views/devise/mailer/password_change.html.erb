<%
  brand_name = global_config['BRAND_NAME'] || 'newrelay'
  recipient_name = @resource.name.presence || @resource.email
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: nil,
  action_url: nil,
  detail_rows: [],
  eyebrow: 'Security',
  heading: 'Your password was changed',
  info_text: 'If you made this change, no further action is needed. If you did not, reset your password immediately.',
  info_title: 'Password updated',
  intro_text: "We're contacting you to confirm that the password on your #{brand_name} account was changed.",
  recipient_name: recipient_name,
  supporting_text: 'This is a security notice only.'
} %>

<%
  brand_name = global_config['BRAND_NAME'] || 'newrelay'
  recipient_name = @resource.name.presence || @resource.email
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: 'Change my password',
  action_url: frontend_url('auth/password/edit', reset_password_token: @token),
  detail_rows: [],
  eyebrow: 'Password reset',
  heading: 'Reset your password',
  info_text: nil,
  info_title: nil,
  intro_text: "Someone requested a link to change the password on your #{brand_name} account.",
  recipient_name: recipient_name,
  supporting_text: 'If you did not request this, you can ignore this email. Your password will not change until you create a new one.'
} %>

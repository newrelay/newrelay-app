<%
  brand_name = global_config['BRAND_NAME'] || 'newrelay'
  recipient_name = @resource.name.presence || @resource.email
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: 'Unlock my account',
  action_url: frontend_url('auth/unlock', unlock_token: @token),
  detail_rows: [],
  eyebrow: 'Account locked',
  heading: 'Unlock your account',
  icon: 'unlock',
  info_text: nil,
  info_title: nil,
  intro_text: "Your #{brand_name} account was locked after too many unsuccessful sign-in attempts.",
  recipient_name: recipient_name,
  supporting_text: 'Use the button below to unlock it and sign in again.'
} %>

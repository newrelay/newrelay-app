<% if field.data.present? %>
  <dl class="grid grid-cols-2 gap-4 m-0">
    <% field.available_limits.each do |key, display_name| %>
      <div class="bg-muted p-3 rounded-md border border-border">
        <dt class="text-xs font-semibold text-muted-foreground uppercase tracking-wider"><%= display_name %></dt>
        <dd class="mt-1 text-lg font-medium text-foreground">
          <%= field.limit_value(key).present? ? field.limit_value(key) : "Unlimited" %>
        </dd>
      </div>
    <% end %>
  </dl>
<% else %>
  <span class="text-muted-foreground italic">No limits explicitly overridden (Unlimited)</span>
<% end %>

<% if field.data.present? %>
  <div class="limits-show-list">
    <% field.available_limits.each do |key, display_name| %>
      <div class="limits-show-row">
        <span class="limits-show-key"><%= display_name %>:</span>
        <span class="limits-show-val"><%= field.limit_value(key).presence || '—' %></span>
      </div>
    <% end %>
  </div>
<% else %>
  <span class="text-muted-foreground">—</span>
<% end %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" style="margin: 0;">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title></title>
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <style type="text/css">
      body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; max-width: 100%; }
      body {
        margin: 0;
        padding: 0;
        width: 100% !important;
        background-color: #E8EEF5;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      .email-container { width: 100%; max-width: 500px; }
      .inner-content p { margin: 0 0 10px; font-size: 13px; line-height: 20px; color: #334155; }
      .inner-content a { color: #5551FF; font-weight: 600; text-decoration: none; }
      .inner-content h4 { margin: 0; font-size: 12px; font-weight: 700; color: #0F172A; }
      .inner-content ul, .inner-content ol { margin: 0 0 12px; padding-left: 18px; color: #334155; font-size: 13px; line-height: 20px; }
      @media only screen and (max-width: 600px) {
        .email-wrapper { padding: 20px 8px !important; }
        .inner-content { padding-left: 14px !important; padding-right: 14px !important; }
        .card-shell { width: 100% !important; max-width: 100% !important; }
      }
    </style>
  </head>

  {% assign brand_name = global_config['BRAND_NAME'] %}
  {% if brand_name == nil or brand_name == '' %}
    {% assign brand_name = 'newrelay' %}
  {% endif %}
  {% assign brand_url = global_config['BRAND_URL'] %}
  {% assign brand_logo = global_config['LOGO'] %}
  {% if brand_logo == nil or brand_logo == '' %}
    {% assign brand_logo = '/brand-assets/logo.svg' %}
  {% endif %}
  {% assign show_email_icon = false %}
  {% if email_icon_url != nil and email_icon_url != '' %}
    {% assign show_email_icon = true %}
  {% endif %}

  <body style="margin: 0; padding: 0; background-color: #E8EEF5;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #E8EEF5;">
      <tr>
        <td align="center" class="email-wrapper" style="padding: 40px 16px 60px 16px;">
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container card-shell" style="max-width: 500px; box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08); border-radius: 18px; overflow: hidden; background-color: #E8EEF5;">

            <tr>
              <td colspan="3" style="padding: 0; line-height: 0; font-size: 0; background-color: #FFFFFF;">
                <svg width="100%" height="22" viewBox="0 0 500 22" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                  <defs>
                    <linearGradient id="smoothArchGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#1E88E5" />
                      <stop offset="50%" stop-color="#6366F1" />
                      <stop offset="100%" stop-color="#7E22CE" />
                    </linearGradient>
                  </defs>
                  <path d="M 0,18 A 18,18 0 0 1 18,0 L 482,0 A 18,18 0 0 1 500,18 L 500,22 L 492,22 L 492,14 A 14,14 0 0 0 478,8 L 22,8 A 14,14 0 0 0 8,14 L 8,22 L 0,22 Z" fill="url(#smoothArchGrad)" />
                </svg>
              </td>
            </tr>

            <tr>
              <td width="8" valign="bottom" bgcolor="#1E88E5" style="width: 8px; min-width: 8px; max-width: 8px; padding: 0; background-color: #1E88E5; font-size: 0; line-height: 0;">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                  <polygon points="0,0 8,0 0,8" fill="#1E88E5" />
                  <polygon points="0,8 8,0 8,8" fill="#E8EEF5" />
                </svg>
              </td>

              <td valign="top" style="background-color: #FFFFFF; padding: 0;">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td align="left" style="padding: 12px 24px 8px 24px;">
                      {% if brand_url != nil and brand_url != '' %}
                        <a href="{{ brand_url }}" style="text-decoration: none; display: inline-block;">
                          <img src="{{ brand_logo }}" alt="{{ brand_name }}" height="28" style="height: 28px; max-width: 180px; border: none; display: block;" />
                        </a>
                      {% else %}
                        <img src="{{ brand_logo }}" alt="{{ brand_name }}" height="28" style="height: 28px; max-width: 180px; border: none; display: block;" />
                      {% endif %}
                    </td>
                  </tr>

                  {% if show_email_icon %}
                  <tr>
                    <td align="center" style="padding: 4px 24px 8px 24px;">
                      <img src="{{ email_icon_url }}" alt="" width="160" height="160" style="width: 160px; height: auto; max-width: 160px; border: 0; display: block; margin: 0 auto;" />
                    </td>
                  </tr>
                  {% endif %}

                  {% if email_heading != nil and email_heading != '' %}
                    <tr>
                      <td align="center" style="padding: 0 24px 22px 24px;">
                        <h2 style="margin: 0 0 6px 0; font-size: 20px; font-weight: 800; color: #0F172A; line-height: 26px; letter-spacing: -0.3px;">
                          {{ email_heading }}
                        </h2>
                        {% if email_subtitle != nil and email_subtitle != '' %}
                          <p style="margin: 0; font-size: 13px; line-height: 20px; color: #64748B;">
                            {{ email_subtitle }}
                          </p>
                        {% endif %}
                      </td>
                    </tr>
                  {% endif %}
                </table>
              </td>

              <td width="8" valign="bottom" bgcolor="#7E22CE" style="width: 8px; min-width: 8px; max-width: 8px; padding: 0; background-color: #7E22CE; font-size: 0; line-height: 0;">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                  <polygon points="0,0 8,0 8,8" fill="#7E22CE" />
                  <polygon points="0,0 0,8 8,8" fill="#E8EEF5" />
                </svg>
              </td>
            </tr>

            <tr>
              <td width="8" style="width: 8px; min-width: 8px; max-width: 8px; background-color: #E8EEF5; padding: 0; font-size: 1px; line-height: 1px;">&nbsp;</td>
              <td valign="top" class="inner-content" style="background-color: #FFFFFF; padding: 12px 24px 0 24px; border-radius: 0 0 14px 14px;">
                {{ content_for_layout }}

                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td align="center" style="padding: 18px 0 24px 0; border-top: 1px solid #E5E7EB;">
                      <p style="margin: 0; font-size: 12px; color: #64748B;">Thanks for using {{ brand_name }}.</p>
                      {% if brand_url != nil and brand_url != '' %}
                        <p style="margin: 4px 0 0 0; font-size: 14px; font-weight: 800; color: #0F172A;">
                          <a href="{{ brand_url }}" style="color: #0F172A; text-decoration: none;">{{ brand_name }}</a>
                        </p>
                      {% else %}
                        <p style="margin: 4px 0 0 0; font-size: 14px; font-weight: 800; color: #0F172A;">{{ brand_name }}</p>
                      {% endif %}
                    </td>
                  </tr>
                </table>
              </td>
              <td width="8" style="width: 8px; min-width: 8px; max-width: 8px; background-color: #E8EEF5; padding: 0; font-size: 1px; line-height: 1px;">&nbsp;</td>
            </tr>

            <tr>
              <td colspan="3" height="8" style="background-color: #E8EEF5; line-height: 8px; font-size: 1px; border-radius: 0 0 18px 18px;">&nbsp;</td>
            </tr>
          </table>

          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; margin-top: 18px;">
            <tr>
              <td align="center" style="font-size: 11px; line-height: 17px; color: #94A3B8;">
                You received this email because you have a {{ brand_name }} account.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" style="margin: 0;">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title></title>
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <style type="text/css">
      body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; max-width: 100%; }
      .mascot-stage {
        position: relative;
        display: inline-block;
        margin: 0 auto 20px auto;
        text-align: center;
        width: 260px;
        height: 230px;
        overflow: visible;
      }
      .mascot-img {
        display: block;
        margin: 0 auto;
        width: 240px;
        max-width: 240px;
        height: auto;
      }
      .help-icon-badge {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background-color: #ffe0c5;
      }
      .help-icon-svg {
        display: block;
        margin: 0 auto;
      }
      body {
        margin: 0;
        padding: 0;
        width: 100% !important;
        background-color: #f1f4f9;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      .email-container { width: 100%; max-width: 580px; }
      .inner-content p { margin: 0 0 10px; font-size: 14px; line-height: 22px; color: #64748b; }
      .inner-content a { color: #ea580c; font-weight: 600; text-decoration: none; }
      .inner-content h4 { margin: 0; font-size: 12px; font-weight: 700; color: #0F172A; }
      .inner-content ul, .inner-content ol { margin: 0 0 12px; padding-left: 18px; color: #64748b; font-size: 14px; line-height: 22px; }
      @media only screen and (max-width: 600px) {
        .email-wrapper { padding: 16px 8px !important; }
        .gradient-pad { padding: 12px !important; }
        .card-header { padding: 20px 20px 10px 20px !important; }
        .card-body { padding: 16px 20px 28px 20px !important; }
        .mascot-stage { width: 210px !important; height: 180px !important; overflow: visible !important; }
        .mascot-img { width: 200px !important; max-width: 200px !important; }
      }
    </style>
  </head>

  {% assign brand_name = global_config['BRAND_NAME'] %}
  {% if brand_name == nil or brand_name == '' %}
    {% assign brand_name = 'newrelay' %}
  {% endif %}
  {% assign brand_url = global_config['BRAND_URL'] %}
  {% assign brand_logo = global_config['LOGO'] %}
  {% if brand_logo == nil or brand_logo == '' %}
    {% assign brand_logo = '/brand-assets/logo_email.png' %}
  {% endif %}
  {% assign show_email_icon = false %}
  {% if email_icon_url != nil and email_icon_url != '' %}
    {% assign show_email_icon = true %}
  {% endif %}

  <body style="margin: 0; padding: 0; background-color: #f1f4f9;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f1f4f9;">
      <tr>
        <td align="center" class="email-wrapper" style="padding: 40px 16px 60px 16px;">

          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" bgcolor="#ffffff" style="max-width: 580px; background-color: #ffffff; background-image: linear-gradient(180deg, #ea580c 0%, #f97316 18%, #fdba74 32%, #fed7aa 40%, #ffedd5 46%, #ffffff 52%, #ffffff 100%); border-radius: 28px; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08); overflow: hidden;">
            <tr>
              <td class="gradient-pad" style="padding: 16px;">

                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; border-radius: 20px; border: 0px solid #efe8e2; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07); overflow: hidden;">

                  <tr>
                    <td class="card-header" align="left" style="padding: 28px 32px 12px 32px;">
                      {% if brand_url != nil and brand_url != '' %}
                        <a href="{{ brand_url }}" style="text-decoration: none; display: inline-block;">
                          <img src="{{ brand_logo }}" alt="{{ brand_name }}" height="32" style="height: 32px; max-height: 36px; max-width: 180px; width: auto; border: 0; display: block;" />
                        </a>
                      {% else %}
                        <img src="{{ brand_logo }}" alt="{{ brand_name }}" height="32" style="height: 32px; max-height: 36px; max-width: 180px; width: auto; border: 0; display: block;" />
                      {% endif %}
                    </td>
                  </tr>

                  <tr>
                    <td class="card-body" align="center" style="padding: 20px 32px 36px 32px;">

                      {% if show_email_icon %}
                        <div class="mascot-stage">
                          <img src="{{ email_icon_url }}" alt="" class="mascot-img" />
                        </div>
                      {% endif %}

                      {% if email_heading != nil and email_heading != '' %}
                        <h1 style="margin: 0; font-size: 24px; line-height: 32px; font-weight: 700; color: #000000; letter-spacing: -0.5px;">
                          {{ email_heading }}
                        </h1>
                        {% if email_subtitle != nil and email_subtitle != '' %}
                          <p style="margin: 12px auto 0 auto; max-width: 380px; font-size: 14px; line-height: 22px; color: #64748b;">
                            {{ email_subtitle }}
                          </p>
                        {% endif %}
                      {% endif %}

                      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                        <tr>
                          <td class="inner-content" align="center" style="padding: 20px 0 0 0; text-align: left;">
                            {{ content_for_layout }}
                          </td>
                        </tr>
                      </table>

                      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#fdf5ef" style="margin: 38px 0 28px 0; background-color: #fdf5ef; border-radius: 16px;">
                        <tr>
                          <td width="54" valign="middle" align="left" style="width: 54px; padding: 20px 0 20px 24px; vertical-align: middle;">
                            <table role="presentation" class="help-icon-badge" border="0" cellpadding="0" cellspacing="0" width="46" height="46" style="width: 46px; height: 46px; background-color: #ffe0c5; border-radius: 50%;">
                              <tr>
                                <td align="center" valign="middle" width="46" height="46" style="width: 46px; height: 46px; text-align: center; vertical-align: middle; line-height: 0; font-size: 0;">
                                  <svg class="help-icon-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; margin: 0 auto;">
                                    <rect x="2" y="4" width="20" height="16" rx="3"></rect>
                                    <path d="M22 7L12 14L2 7"></path>
                                  </svg>
                                </td>
                              </tr>
                            </table>
                          </td>
                          <td valign="middle" align="left" style="padding: 20px 24px 20px 16px; vertical-align: middle;">
                            <p style="margin: 0 0 3px 0; font-size: 15px; font-weight: 700; color: #0f172a;">Need anything else?</p>
                            <p style="margin: 0; font-size: 14px; line-height: 20px; color: #64748b;">Log in to {{ brand_name }} to manage your messages, automations and more.</p>
                          </td>
                        </tr>
                      </table>

                      <div style="border-top: 1px solid #f1f5f9; margin: 8px 0 20px 0; font-size: 0; line-height: 0;">&nbsp;</div>

                      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                        <tr>
                          <td align="left" valign="middle" style="padding-bottom: 8px;">
                            <img src="{{ brand_logo }}" alt="{{ brand_name }}" height="28" style="height: 28px; max-height: 32px; max-width: 160px; width: auto; border: 0; display: block;" />
                          </td>
                          <td align="right" valign="middle" style="padding-bottom: 8px; white-space: nowrap;">
                            <a href="https://www.linkedin.com/company/newrelay" style="display: inline-block; margin-left: 10px; text-decoration: none; opacity: 0.85;">
                              <svg width="17" height="17" viewBox="0 0 24 24" fill="#64748b"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                            </a>
                            <a href="https://x.com/newrelayai" style="display: inline-block; margin-left: 10px; text-decoration: none; opacity: 0.85;">
                              <svg width="15" height="15" viewBox="0 0 24 24" fill="#64748b"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                            </a>
                            <a href="https://www.instagram.com/newrelay" style="display: inline-block; margin-left: 10px; text-decoration: none; opacity: 0.85;">
                              <svg width="17" height="17" viewBox="0 0 24 24" fill="#64748b"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                            </a>
                            {% if brand_url != nil and brand_url != '' %}
                              <a href="{{ brand_url }}" style="display: inline-block; margin-left: 10px; text-decoration: none; opacity: 0.85;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                              </a>
                            {% endif %}
                          </td>
                        </tr>
                        <tr>
                          <td align="left" valign="top" style="font-size: 11px; color: #94a3b8; line-height: 16px; padding-top: 4px;">
                            &copy; 2026 {{ brand_name }}. All rights reserved.
                          </td>
                          <td align="right" valign="top" style="font-size: 11px; color: #64748b; line-height: 16px; padding-top: 4px;">
                            {% if brand_url != nil and brand_url != '' %}
                              <a href="{{ brand_url }}" style="color: #64748b; text-decoration: none;">Help Center</a>
                              <span style="color: #cbd5e1; margin: 0 5px;">|</span>
                              <a href="{{ brand_url }}" style="color: #64748b; text-decoration: none;">Privacy</a>
                            {% endif %}
                          </td>
                        </tr>
                      </table>

                    </td>
                  </tr>
                </table>

              </td>
            </tr>
          </table>

        </td>
      </tr>
    </table>
  </body>
</html>

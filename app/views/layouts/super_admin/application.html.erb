<%#
# Application Layout

This view template is used as the layout
for every page that Administrate generates.

By default, it renders:
- Navigation
- Content for a search bar
  (if provided by a `content_for` block in a nested page)
- Flashes
- Links to stylesheets and JavaScripts
%>

<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="w-full h-full">
<head>
  <meta charset="utf-8">
  <meta name="ROBOTS" content="NOODP">
  <meta name="viewport" content="initial-scale=1">
  <title>
    <%= content_for(:title) %> - <%= application_title %>
  </title>
  <%= render "stylesheet" %>
  <%= vite_client_tag %>
  <%= vite_javascript_tag 'superadmin' %>
  <%= vite_javascript_tag 'superadmin_pages' %>
  <%= csrf_meta_tags %>
</head>
<body class="antialiased w-full h-full bg-background text-foreground" data-relay="true">
  <style>
    #global-loader {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background-color: var(--background, #ffffff);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.3s ease-out, visibility 0.3s ease-out;
    }
    .loader-hidden {
      opacity: 0;
      visibility: hidden;
    }
    .spinner {
      width: 2.5rem;
      height: 2.5rem;
      border: 3px solid var(--border, #e4e7ee);
      border-top-color: var(--primary, #4f46e5);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
  <div id="global-loader">
    <div class="spinner"></div>
  </div>
  <script>
    window.addEventListener('load', function() {
      var loader = document.getElementById('global-loader');
      if (loader) {
        loader.classList.add('loader-hidden');
        setTimeout(function() { loader.remove(); }, 300);
      }
    });
  </script>

  <%= render "icons" %>
  <div class="flex w-full h-full">
    <%= render "navigation" -%>
    <main class="flex-1 flex flex-col min-w-0 overflow-auto bg-background" role="main">
      <%= render "flashes" -%>
      <div class="flex-1 p-6">
        <%= yield %>
      </div>
    </main>
  </div>
  <%= render "javascript" %>
</body>
</html>

<p>Hi,</p>
<p>An account was permanently deleted from your NewRelay instance.</p>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 8px 0 16px;">
  <tr>
    <td style="padding: 9px 0; font-size: 13px; font-weight: 600; color: #334155;">Installation</td>
    <td align="right" style="padding: 9px 0; font-size: 13px; font-weight: 700; color: #0F172A;">{{ meta.instance_url }}</td>
  </tr>
  <tr>
    <td style="padding: 9px 0; font-size: 13px; font-weight: 600; color: #334155;">Account</td>
    <td align="right" style="padding: 9px 0; font-size: 14px; font-weight: 800; color: #0F172A;">{{ meta.account_name }} (#{{ meta.account_id }})</td>
  </tr>
  <tr>
    <td style="padding: 9px 0; font-size: 13px; font-weight: 600; color: #334155;">Deleted at</td>
    <td align="right" style="padding: 9px 0; font-size: 13px; font-weight: 700; color: #0F172A;">{{ meta.deleted_at }}</td>
  </tr>
  <tr>
    <td style="padding: 9px 0; font-size: 13px; font-weight: 600; color: #334155;">Reason</td>
    <td align="right" style="padding: 9px 0; font-size: 13px; font-weight: 700; color: #0F172A;">{{ meta.deletion_reason }}</td>
  </tr>
</table>
{% if meta.deleted_user_count > 0 %}
  <p><strong>Deleted users ({{ meta.deleted_user_count }})</strong></p>
  {% for user in meta.soft_deleted_users %}
    <p>User ID {{ user.user_id }} — {{ user.user_email }}</p>
  {% endfor %}
{% else %}
  <p>No users were listed with this deletion.</p>
{% endif %}
<p>Keep this email as a compliance record.</p>

<p>Hi,</p>
<p>Your contact import is complete. Open Contacts to review the records.</p>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 8px 0 16px;">
  <tr>
    <td style="padding: 9px 0; font-size: 13px; font-weight: 600; color: #334155;">Imported</td>
    <td align="right" style="padding: 9px 0; font-size: 14px; font-weight: 800; color: #0F172A;">{{ meta.imported_contacts }}</td>
  </tr>
  <tr>
    <td style="padding: 9px 0; font-size: 13px; font-weight: 600; color: #334155;">Failed</td>
    <td align="right" style="padding: 9px 0; font-size: 14px; font-weight: 800; color: #0F172A;">{{ meta.failed_contacts }}</td>
  </tr>
</table>
{% if meta.failed_contacts == 0 %}
  <p style="margin: 16px 0 0; text-align: center;">
    <a href="{{ action_url }}" style="display: inline-block; background-color: #ea580c; background-image: linear-gradient(145deg, #ea580c 0%, #f97316 55%, #fb923c 100%); color: #ffffff; font-size: 15px; font-weight: 700; text-decoration: none; padding: 10px 35px; border-radius: 16px; border: 1px solid #fed7aa;">View contacts →</a>
  </p>
{% else %}
  <p style="margin: 16px 0 0; text-align: center;">
    <a href="{{ action_url }}" style="display: inline-block; background-color: #ea580c; background-image: linear-gradient(145deg, #ea580c 0%, #f97316 55%, #fb923c 100%); color: #ffffff; font-size: 15px; font-weight: 700; text-decoration: none; padding: 10px 35px; border-radius: 16px; border: 1px solid #fed7aa;">View failed records →</a>
  </p>
{% endif %}

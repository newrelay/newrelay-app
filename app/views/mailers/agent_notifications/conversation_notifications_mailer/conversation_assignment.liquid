<p>Hi {{ user.available_name }},</p>

<p>A conversation was assigned to you. Open it when you are ready to reply.</p>

{% for chat_message in conversation.recent_messages %}
  <p style="margin: 12px 0 4px; font-size: 12px; font-weight: 700; color: #0F172A;">
    {% if chat_message.sender == user.available_name %}You{% else %}{{ chat_message.sender }}{% endif %}
  </p>
  <div style="padding: 10px 14px; margin: 0 0 12px 0; background: #F9FAFB; border: 1px solid #E8EEF5; border-radius: 12px; font-size: 13px; line-height: 20px; color: #334155;">
    {% if chat_message.content %}{{ chat_message.content }}{% endif %}
    {% if chat_message.attachments %}
      {% for attachment in chat_message.attachments %}
        <div>Attachment — <a href="{{ attachment }}">View file</a></div>
      {% endfor %}
    {% endif %}
  </div>
{% endfor %}

<p style="margin: 16px 0 0; text-align: center;">
  <a href="{{ action_url }}" style="display: inline-block; background-color: #ea580c; background-image: linear-gradient(145deg, #ea580c 0%, #f97316 55%, #fb923c 100%); color: #ffffff; font-size: 15px; font-weight: 700; text-decoration: none; padding: 10px 35px; border-radius: 16px; border: 1px solid #fed7aa;">Open conversation →</a>
</p>

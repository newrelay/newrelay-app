<div style="padding: 12px 14px; margin: 0 0 16px 0; background: #fdf5ef; border: 1px solid #fed7aa; border-radius: 12px; font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 13px; font-weight: 600; color: #ea580c; word-break: break-all;">

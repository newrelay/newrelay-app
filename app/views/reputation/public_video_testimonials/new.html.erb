<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leave a Video Testimonial</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 font-sans">
  
  <div class="max-w-xl w-full bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="p-6 md:p-8 space-y-6">
      
      <div class="text-center space-y-2">
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight"><%= @account.name %> would love a video testimonial!</h1>
        <p class="text-sm text-slate-500">Share your experience with us. You can either record a quick video right here or upload one from your device.</p>
      </div>

      <div id="success-state" class="hidden text-center py-12 space-y-4">
        <div class="mx-auto size-16 bg-emerald-100 text-emerald-500 rounded-full flex items-center justify-center mb-4">
          <svg class="size-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900">Thank you!</h3>
        <p class="text-sm text-slate-500">Your video testimonial has been submitted successfully.</p>
      </div>

      <form id="video-form" class="space-y-5">
        
        <!-- Video Input Area -->
        <div class="space-y-3">
          <label class="block text-sm font-bold text-slate-700">Your Video</label>
          
          <!-- Video Preview -->
          <div id="video-preview-container" class="hidden relative aspect-video bg-black rounded-xl overflow-hidden shadow-inner">
            <video id="preview-video" class="w-full h-full object-cover" controls playsinline></video>
            <button type="button" id="remove-video-btn" class="absolute top-2 right-2 bg-red-500 hover:bg-red-600 text-white p-1.5 rounded-lg shadow-sm">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>

          <!-- Video Recorder Box -->
          <div id="recording-container" class="hidden relative aspect-video bg-black rounded-xl overflow-hidden shadow-inner flex flex-col items-center justify-center">
            <video id="live-video" class="absolute inset-0 w-full h-full object-cover" autoplay muted playsinline></video>
            <div class="absolute bottom-4 left-0 right-0 flex justify-center gap-4">
              <button type="button" id="start-record-btn" class="px-4 py-2 bg-red-500 text-white rounded-full font-bold text-sm shadow-lg flex items-center gap-2">
                <span class="size-2.5 bg-white rounded-full animate-pulse"></span> Start Recording
              </button>
              <button type="button" id="stop-record-btn" class="hidden px-4 py-2 bg-slate-900 text-white rounded-full font-bold text-sm shadow-lg flex items-center gap-2">
                <span class="size-2.5 bg-red-500 rounded-sm"></span> Stop Recording
              </button>
            </div>
            <div id="recording-timer" class="hidden absolute top-4 left-4 bg-black/50 text-white px-2 py-1 rounded-md font-mono text-xs font-bold backdrop-blur-sm">
              00:00
            </div>
          </div>

          <!-- Action Buttons -->
          <div id="video-actions" class="grid grid-cols-2 gap-3">
            <button type="button" id="open-camera-btn" class="flex flex-col items-center justify-center py-6 border-2 border-dashed border-slate-200 hover:border-blue-500 hover:bg-blue-50 rounded-xl transition-colors text-slate-500 hover:text-blue-600">
              <svg class="size-8 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span class="text-sm font-bold">Record Video</span>
            </button>
            
            <label class="cursor-pointer flex flex-col items-center justify-center py-6 border-2 border-dashed border-slate-200 hover:border-blue-500 hover:bg-blue-50 rounded-xl transition-colors text-slate-500 hover:text-blue-600">
              <svg class="size-8 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              <span class="text-sm font-bold">Upload Video</span>
              <input type="file" id="upload-video-input" accept="video/*" class="hidden" />
            </label>
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="block text-sm font-bold text-slate-700">Testimonial Title</label>
          <input type="text" id="title-input" required placeholder="e.g. Amazing experience!" class="w-full rounded-xl border border-slate-200 p-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div class="space-y-1.5">
          <label class="block text-sm font-bold text-slate-700">Your Email Address</label>
          <input type="email" id="email-input" required placeholder="you@example.com" class="w-full rounded-xl border border-slate-200 p-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <button type="submit" id="submit-btn" disabled class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white rounded-xl font-bold text-sm transition-colors flex items-center justify-center gap-2">
          Submit Testimonial
        </button>

      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('video-form');
    const videoActions = document.getElementById('video-actions');
    const recordingContainer = document.getElementById('recording-container');
    const previewContainer = document.getElementById('video-preview-container');
    const liveVideo = document.getElementById('live-video');
    const previewVideo = document.getElementById('preview-video');
    const startRecordBtn = document.getElementById('start-record-btn');
    const stopRecordBtn = document.getElementById('stop-record-btn');
    const openCameraBtn = document.getElementById('open-camera-btn');
    const uploadInput = document.getElementById('upload-video-input');
    const removeVideoBtn = document.getElementById('remove-video-btn');
    const submitBtn = document.getElementById('submit-btn');
    const successState = document.getElementById('success-state');
    
    let stream = null;
    let mediaRecorder = null;
    let recordedChunks = [];
    let finalVideoBlob = null;
    let timerInterval = null;
    let recordingSeconds = 0;

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60).toString().padStart(2, '0');
      const s = (seconds % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    function checkSubmitReady() {
      submitBtn.disabled = !finalVideoBlob;
    }

    // Handle Upload
    uploadInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) {
        finalVideoBlob = e.target.files[0];
        previewVideo.src = URL.createObjectURL(finalVideoBlob);
        videoActions.classList.add('hidden');
        previewContainer.classList.remove('hidden');
        checkSubmitReady();
      }
    });

    // Remove selected/recorded video
    removeVideoBtn.addEventListener('click', () => {
      finalVideoBlob = null;
      previewVideo.src = '';
      previewContainer.classList.add('hidden');
      videoActions.classList.remove('hidden');
      uploadInput.value = '';
      checkSubmitReady();
    });

    // Start Webcam
    openCameraBtn.addEventListener('click', async () => {
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        liveVideo.srcObject = stream;
        videoActions.classList.add('hidden');
        recordingContainer.classList.remove('hidden');
      } catch (err) {
        alert('Camera access denied or unavailable.');
      }
    });

    // Start Recording
    startRecordBtn.addEventListener('click', () => {
      recordedChunks = [];
      mediaRecorder = new MediaRecorder(stream);
      
      mediaRecorder.ondataavailable = e => {
        if (e.data.size > 0) recordedChunks.push(e.data);
      };

      mediaRecorder.onstop = () => {
        finalVideoBlob = new Blob(recordedChunks, { type: 'video/webm' });
        previewVideo.src = URL.createObjectURL(finalVideoBlob);
        
        // Cleanup stream
        stream.getTracks().forEach(track => track.stop());
        recordingContainer.classList.add('hidden');
        previewContainer.classList.remove('hidden');
        
        clearInterval(timerInterval);
        checkSubmitReady();
      };

      mediaRecorder.start();
      startRecordBtn.classList.add('hidden');
      stopRecordBtn.classList.remove('hidden');
      document.getElementById('recording-timer').classList.remove('hidden');
      
      recordingSeconds = 0;
      document.getElementById('recording-timer').innerText = '00:00';
      timerInterval = setInterval(() => {
        recordingSeconds++;
        document.getElementById('recording-timer').innerText = formatTime(recordingSeconds);
      }, 1000);
    });

    // Stop Recording
    stopRecordBtn.addEventListener('click', () => {
      mediaRecorder.stop();
      startRecordBtn.classList.remove('hidden');
      stopRecordBtn.classList.add('hidden');
      document.getElementById('recording-timer').classList.add('hidden');
    });

    // Submit form
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!finalVideoBlob) return;

      submitBtn.disabled = true;
      submitBtn.innerText = 'Uploading...';

      const formData = new FormData();
      formData.append('title', document.getElementById('title-input').value);
      formData.append('email', document.getElementById('email-input').value);
      <% if params[:token].present? %>
      formData.append('token', '<%= params[:token] %>');
      <% end %>
      
      // Upload blob as a file
      const fileName = finalVideoBlob.name || 'video.mp4';
      const ext = fileName.includes('.') ? fileName.split('.').pop() : 'mp4';
      formData.append('video', finalVideoBlob, `testimonial.${ext}`);

      try {
        const res = await fetch('<%= reputation_video_testimonials_path(@account) %>', {
          method: 'POST',
          body: formData
        });
        
        if (res.ok) {
          form.classList.add('hidden');
          successState.classList.remove('hidden');
        } else {
          alert('Failed to upload video.');
          submitBtn.disabled = false;
          submitBtn.innerText = 'Submit Testimonial';
        }
      } catch (err) {
        alert('Network error during upload.');
        submitBtn.disabled = false;
        submitBtn.innerText = 'Submit Testimonial';
      }
    });

  </script>
</body>
</html>

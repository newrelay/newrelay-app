<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @testimonial.customer_name.presence || 'Video testimonial' %> · <%= @account.name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { colors: {
        brand: { DEFAULT: '#6366f1', hover: '#4f46e5', soft: '#eef2ff' },
        ink: { DEFAULT: '#0f172a', muted: '#64748b', line: '#e2e8f0' }
      } } }
    };
  </script>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 font-sans text-ink">
  <div class="max-w-xl w-full bg-white rounded-2xl shadow-sm border border-ink-line overflow-hidden">
    <div class="aspect-video bg-black">
      <video class="w-full h-full object-contain" controls playsinline
             <% if @testimonial.thumbnail.attached? %>poster="<%= url_for(@testimonial.thumbnail) %>"<% end %>>
        <source src="<%= url_for(@testimonial.video) %>">
      </video>
    </div>

    <div class="p-6 md:p-8 space-y-4">
      <% if @testimonial.rating.to_i.positive? %>
      <div class="flex gap-1" aria-label="<%= @testimonial.rating %> out of 5">
        <% (1..5).each do |n| %>
        <svg class="size-5 <%= n <= @testimonial.rating ? 'text-amber-400' : 'text-slate-300' %>" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.446a1 1 0 00-.364 1.118l1.287 3.957c.3.922-.755 1.688-1.54 1.118l-3.367-2.446a1 1 0 00-1.175 0l-3.368 2.446c-.783.57-1.838-.196-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.075 9.394c-.783-.57-.38-1.81.588-1.81h4.163a1 1 0 00.95-.69l1.286-3.957z"/></svg>
        <% end %>
      </div>
      <% end %>

      <% if @testimonial.title.present? %>
      <h1 class="text-xl font-extrabold tracking-tight">&ldquo;<%= @testimonial.title %>&rdquo;</h1>
      <% end %>

      <div class="flex items-center justify-between pt-2 border-t border-ink-line">
        <div>
          <p class="text-sm font-bold"><%= @testimonial.customer_name.presence || 'A happy customer' %></p>
          <% if @testimonial.company.present? %><p class="text-xs text-ink-muted"><%= @testimonial.company %></p><% end %>
        </div>
        <p class="text-xs text-ink-muted">for <%= @account.name %></p>
      </div>
    </div>
  </div>
</body>
</html>

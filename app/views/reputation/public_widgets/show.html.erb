<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= @is_video ? 'Video testimonials' : 'Reviews' %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; background: transparent; color: #1f2933; padding: 12px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
    .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
    .stars { color: #f59e0b; font-size: 13px; margin-bottom: 8px; letter-spacing: 1px; }
    .quote { font-size: 13.5px; line-height: 1.5; color: #374151; margin-bottom: 10px; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
    .meta { font-size: 12px; color: #6b7280; font-weight: 600; }
    .meta span { font-weight: 400; color: #9ca3af; }
    video { width: 100%; border-radius: 8px; background: #000; margin-bottom: 10px; display: block; max-height: 220px; }
    .empty { text-align: center; padding: 40px 16px; color: #9ca3af; font-size: 13.5px; }
    .footer { text-align: center; font-size: 11px; color: #b0b7c3; margin-top: 14px; }
  </style>
</head>
<body>
  <% if @items.empty? %>
    <div class="empty"><%= @is_video ? 'No video testimonials yet.' : 'No reviews yet.' %></div>
  <% else %>
    <div class="grid">
      <% @items.each do |item| %>
        <div class="card">
          <% if @is_video %>
            <% if item.video.attached? %>
              <video controls playsinline poster="<%= item.thumbnail.attached? ? url_for(item.thumbnail) : nil %>">
                <source src="<%= url_for(item.video) %>">
              </video>
            <% end %>
            <div class="stars"><%= '★' * item.rating.to_i %><span style="color:#e5e7eb"><%= '★' * (5 - item.rating.to_i) %></span></div>
            <div class="meta"><%= item.customer_name.presence || 'Customer' %><% if item.company.present? %><span> · <%= item.company %></span><% end %></div>
          <% else %>
            <div class="stars"><%= '★' * item.rating.to_i %><span style="color:#e5e7eb"><%= '★' * (5 - item.rating.to_i) %></span></div>
            <div class="quote">&ldquo;<%= item.body %>&rdquo;</div>
            <div class="meta"><%= item.reviewer_name.presence || 'Anonymous' %><span> · <%= item.provider.to_s.humanize %></span></div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <% unless @widget.hide_watermark %>
    <div class="footer">Powered by Reviews Widget</div>
  <% end %>
</body>
</html>

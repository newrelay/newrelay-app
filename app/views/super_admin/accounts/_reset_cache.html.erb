<section class="show-sub-card">
  <div class="show-sub-header">
    <div>
      <h3 class="show-sub-title">Frontend Cache</h3>
      <p class="show-sub-subtitle">Clears IndexedDB cache keys from Redis. The next page load will fetch fresh data from the backend.</p>
    </div>
  </div>
  <%= form_for([:reset_cache, namespace, page.resource], method: :post) do |f| %>
    <%= f.submit 'Reset Frontend Cache', class: "btn btn-outline" %>
  <% end %>
</section>

<% if ENV.fetch('ENABLE_ACCOUNT_SEEDING', !Rails.env.production?)  %>
  <section class="show-sub-card">
    <div class="show-sub-header">
      <div>
        <h3 class="show-sub-title">Demo Seed Data</h3>
        <p class="show-sub-subtitle">Generate sample conversations, contacts, and messages for this account.</p>
      </div>
    </div>
    <p class="text-[13.5px] text-destructive mb-4">Warning: Generating seed data will clear all existing conversations, contacts, and messages in this account.</p>
    <%= form_for([:seed, namespace, page.resource], method: :post) do |f| %>
      <%= f.submit 'Generate Seed Data', class: "btn btn-danger-soft" %>
    <% end %>
  </section>
<% end %>

<%
  content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) }
%>

<div class="space-y-6">
  <div class="page-header">
    <%= link_to super_admin_accounts_path, class: "btn btn-outline" do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back</span>
    <% end %>
    <h1 class="page-title">
      <%= content_for(:title) %>
    </h1>
    <% if accessible_action?(page.resource, :edit) %>
      <div class="ml-auto">
        <%= link_to [:edit, namespace, page.resource], class: "btn btn-primary" do %>
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
          <span>Edit Account</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <section class="show-details-card">
    <div class="show-details-inner">
      <% page.attributes.each do |title, attributes| %>
        <% if title.present? %>
          <h3 class="show-section-title">
            <%= t "helpers.label.#{page.resource_name}.#{title}", default: title %>
          </h3>
        <% end %>

        <% attributes.each do |attribute| %>
          <% if %w[all_features manually_managed_features].include?(attribute.name.to_s) %>
            <div class="show-feature-block attribute-data attribute-data--<%= attribute.html_class %>" id="<%= attribute.name %>">
              <%= render_field attribute, page: page %>
            </div>
          <% else %>
            <div class="show-row">
              <div class="show-label" id="<%= attribute.name %>">
                <%= t("helpers.label.#{resource_name}.#{attribute.name}", default: page.resource.class.human_attribute_name(attribute.name)) %>
              </div>
              <div class="show-value attribute-data attribute-data--<%= attribute.html_class %>">
                <% if attribute.name.to_s == 'status' %>
                  <span class="<%= attribute.data.to_s == 'suspended' ? 'text-muted-foreground font-medium' : 'status-text-active' %>">
                    <%= render_field attribute, page: page %>
                  </span>
                <% elsif super_admin_blank_value?(attribute.data) %>
                  <span class="text-muted-foreground">—</span>
                <% else %>
                  <%= render_field attribute, page: page %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </section>

  <%= render partial: 'billing_gateway', locals: { page: page } %>
  <%= render 'super_admin/shared/account_user_form', page: page, namespace: namespace, resource_type: 'account' %>
  <%= render partial: "seed_data", locals: { page: page } %>
  <%= render partial: "reset_cache", locals: { page: page } %>
  <%= render partial: "custom_domain", locals: { page: page } %>
</div>

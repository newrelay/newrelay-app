<% content_for(:title) { "Configure Settings - #{@config.titleize}" } %>

<div class="space-y-6">
  <div class="page-header">
    <%= link_to super_admin_settings_path, class: "btn btn-outline" do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back</span>
    <% end %>
    <div>
      <h1 class="page-title" id="page-title">
        Configure Settings - <%= @config.titleize %>
      </h1>
      <p class="text-[13.5px] text-muted-foreground mt-1">Update installation config for this section. Secrets stay masked until revealed.</p>
    </div>
  </div>

  <section class="form-card">
    <%= form_with url: super_admin_app_config_url(config: @config), method: :post, class: "sa-config-form" do |form| %>
      <% @allowed_configs.each do |key| %>
        <div class="field-unit">
          <div class="field-unit__label">
            <%= form.label "app_config[#{key}]", @installation_configs[key]&.dig('display_title') || key.titleize %>
          </div>
          <div class="field-unit__field">
            <% if @installation_configs[key]&.dig('type') == 'boolean' %>
              <%= form.select "app_config[#{key}]",
                [["True", true], ["False", false]],
                { selected: ActiveModel::Type::Boolean.new.cast(@app_config[key]) },
                class: "form-input cursor-pointer"
              %>
            <% elsif @installation_configs[key]&.dig('type') == 'code' %>
              <%= form.text_area "app_config[#{key}]",
                  value: @app_config[key],
                  rows: 10,
                  wrap: 'off',
                  class: "form-input font-mono text-xs min-h-[160px] py-2"
              %>
            <% elsif @installation_configs[key]&.dig('type') == 'secret' %>
              <div class="relative">
                <%= form.password_field "app_config[#{key}]",
                    id: "app_config_#{key}",
                    value: @app_config[key],
                    class: "form-input pr-10"
                %>
                <button
                  type="button"
                  class="reset-base absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center size-7 rounded-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors toggle-password"
                  data-target="app_config_<%= key %>"
                  aria-label="Toggle visibility"
                >
                  <svg class="eye-show size-4" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5C5.63636 5 2 12 2 12C2 12 5.63636 19 12 19C18.3636 19 22 12 22 12C22 12 18.3636 5 12 5Z"/>
                    <path d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z"/>
                  </svg>
                  <svg class="eye-hide size-4 hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3l18 18"/>
                    <path d="M10.5 10.677a2 2 0 002.823 2.823"/>
                    <path d="M7.362 7.561C5.68 8.74 4.279 10.42 3 12c1.889 2.991 5.282 6 9 6 1.55 0 3.043-.523 4.395-1.35"/>
                    <path d="M12 6c4.008 0 6.701 3.009 9 6a15.66 15.66 0 01-1.078 1.5"/>
                  </svg>
                </button>
              </div>
            <% elsif @installation_configs[key]&.dig('type') == 'select' && @installation_configs[key]&.dig('options').present? %>
              <%= form.select "app_config[#{key}]",
                @installation_configs[key]['options'].map { |val, label| [label, val] },
                { selected: @app_config[key] },
                class: "form-input cursor-pointer"
              %>
            <% else %>
              <%= form.text_field "app_config[#{key}]", id: "app_config_#{key}", value: @app_config[key], class: "form-input" %>
            <% end %>
            <% if @installation_configs[key]&.dig('description').present? %>
              <p class="feature-flags-helper">
                <%= @installation_configs[key]&.dig('description') %>
              </p>
            <% end %>
            <% if key == 'CAPTAIN_OPEN_AI_API_KEY' %>
              <div class="flex items-center gap-3 mt-2">
                <button type="button" id="test-captain-key-btn" class="btn btn-outline reset-base cursor-pointer">
                  Test Connection
                </button>
                <span id="test-captain-key-result" class="text-[13px]"></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="form-actions-bar">
        <%= form.submit "Save Configuration", class: "btn btn-primary reset-base cursor-pointer" %>
      </div>
    <% end %>
  </section>
</div>

<% content_for :javascript do %>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.target;
        const input = document.getElementById(targetId);
        const type = input.type === 'password' ? 'text' : 'password';
        input.type = type;
        button.querySelector('.eye-show').classList.toggle('hidden', type === 'text');
        button.querySelector('.eye-hide').classList.toggle('hidden', type === 'password');
      });
    });

    const testBtn = document.getElementById('test-captain-key-btn');
    if (testBtn) {
      testBtn.addEventListener('click', async () => {
        const resultEl = document.getElementById('test-captain-key-result');
        const apiKey = document.getElementById('app_config_CAPTAIN_OPEN_AI_API_KEY')?.value;
        const apiEndpoint = document.getElementById('app_config_CAPTAIN_OPEN_AI_ENDPOINT')?.value;
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

        testBtn.disabled = true;
        resultEl.textContent = 'Testing…';
        resultEl.className = 'text-[13px] text-muted-foreground';

        try {
          const response = await fetch('<%= test_captain_key_super_admin_app_config_path %>', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken,
            },
            body: JSON.stringify({ api_key: apiKey, api_endpoint: apiEndpoint }),
          });
          const data = await response.json();
          resultEl.textContent = data.valid ? '✓ Connected' : '✗ Key rejected by the provider';
          resultEl.className = data.valid ? 'text-[13px] text-success' : 'text-[13px] text-destructive';
        } catch {
          resultEl.textContent = '✗ Could not reach the provider';
          resultEl.className = 'text-[13px] text-destructive';
        } finally {
          testBtn.disabled = false;
        }
      });
    }
  });
  </script>
<% end %>

<div class="space-y-6">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to super_admin_settings_path, class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-input bg-background text-sm font-medium text-foreground hover:bg-accent hover:border-ring transition-colors" do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back</span>
    <% end %>
    <h1 class="page-title" id="page-title">
      Configure Settings - <%= @config.titleize %>
    </h1>
  </div>


<style>
.eye-icon.eye-hide path {
  d: path('M3 3l18 18M10.5 10.677a2 2 0 002.823 2.823M7.362 7.561C5.68 8.74 4.279 10.42 3 12c1.889 2.991 5.282 6 9 6 1.55 0 3.043-.523 4.395-1.35M12 6c4.008 0 6.701 3.009 9 6a15.66 15.66 0 01-1.078 1.5');
}
</style>

<section class="rounded-xl border border-border bg-card p-6 shadow-xs">
  <%= form_with url: super_admin_app_config_url(config: @config), method: :post, class: "space-y-6" do |form| %>
    <% @allowed_configs.each do |key| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start pb-4 border-b border-border/40 last:border-b-0">
        <div class="pt-1.5">
          <%= form.label "app_config[#{key}]", @installation_configs[key]&.dig('display_title') || key.titleize, class: "text-sm font-medium text-foreground" %>
        </div>
        <div class="md:col-span-2 space-y-1.5">
          <% if @installation_configs[key]&.dig('type') == 'boolean' %>
            <%= form.select "app_config[#{key}]",
              [["True", true], ["False", false]],
              { selected: ActiveModel::Type::Boolean.new.cast(@app_config[key]) },
              class: "flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm shadow-xs text-foreground focus:border-ring transition-colors cursor-pointer"
            %>
          <% elsif @installation_configs[key]&.dig('type') == 'code' %>
            <%= form.text_area "app_config[#{key}]",
                value: @app_config[key],
                rows: 10,
                wrap: 'off',
                class: "flex w-full rounded-md border border-input bg-background p-3 font-mono text-xs shadow-xs text-foreground focus:border-ring transition-colors overflow-auto"
            %>
          <% elsif @installation_configs[key]&.dig('type') == 'secret' %>
            <div class="relative">
              <%= form.password_field "app_config[#{key}]",
                  id: "app_config_#{key}",
                  value: @app_config[key],
                  class: "flex h-9 w-full rounded-md border border-input bg-background pl-3 pr-10 py-1 text-sm shadow-xs text-foreground focus:border-ring transition-colors"
              %>
              <button
                type="button"
                class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center size-7 rounded-sm text-muted-foreground hover:text-foreground transition-colors toggle-password"
                data-target="app_config_<%= key %>"
              >
                <svg class="eye-icon size-4" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5C5.63636 5 2 12 2 12C2 12 5.63636 19 12 19C18.3636 19 22 12 22 12C22 12 18.3636 5 12 5Z"/>
                  <path d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z"/>
                </svg>
              </button>
            </div>
          <% elsif @installation_configs[key]&.dig('type') == 'select' && @installation_configs[key]&.dig('options').present? %>
            <%= form.select "app_config[#{key}]",
              @installation_configs[key]['options'].map { |val, label| [label, val] },
              { selected: @app_config[key] },
              class: "flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm shadow-xs text-foreground focus:border-ring transition-colors cursor-pointer"
            %>
          <% else %>
            <%= form.text_field "app_config[#{key}]", value: @app_config[key], class: "flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm shadow-xs text-foreground focus:border-ring transition-colors" %>
          <% end %>
          <% if @installation_configs[key]&.dig('description').present? %>
            <p class="text-xs text-muted-foreground">
              <%= @installation_configs[key]&.dig('description') %>
            </p>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="pt-4 flex justify-end">
      <%= form.submit "Save Configuration", class: "inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs hover:bg-primary/90 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</section>

<% content_for :javascript do %>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.target;
        const input = document.getElementById(targetId);
        const type = input.type === 'password' ? 'text' : 'password';
        input.type = type;

        // Toggle icon
        const svg = button.querySelector('.eye-icon');
        if (type === 'password') {
          svg.classList.remove('eye-hide')
        } else {
          svg.classList.add('eye-hide')
        }
      });
    });
  });
  </script>
<% end %>

<%#
# Collection
# Displays a collection of resources in an HTML table according to Design System NR rules.
%>

<div class="table-card">
  <table aria-labelledby="<%= table_title %>">
    <thead>
      <tr>
        <% collection_presenter.attribute_types.each do |attr_name, attr_type| %>
          <th
            scope="col"
            role="columnheader"
            aria-sort="<%= sort_order(collection_presenter.ordered_html_class(attr_name)) %>"
          >
            <%= link_to(
              sanitized_order_params(page, collection_field_name).merge(
                collection_presenter.order_params_for(attr_name, key: collection_field_name)
              ),
              class: "inline-flex items-center gap-1.5 hover:text-primary transition-colors font-medium text-foreground"
            ) do %>
              <span>
                <%= t(
                  "helpers.label.#{collection_presenter.resource_name}.#{attr_name}",
                  default: attr_name.to_s,
                ).titleize %>
              </span>
              <% if collection_presenter.ordered_by?(attr_name) %>
                <svg class="size-3.5 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= collection_presenter.ordered_html_class(attr_name) == 'asc' ? '<path d="m18 15-6-6-6 6"/>'.html_safe : '<path d="m6 9 6 6 6-6"/>'.html_safe %></svg>
              <% else %>
                <svg class="size-3.5 opacity-40 shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
              <% end %>
            <% end %>
          </th>
        <% end %>

        <% has_actions = existing_action?(collection_presenter.resource_name, :edit) || existing_action?(collection_presenter.resource_name, :destroy) %>
        <% if has_actions %>
          <th scope="col" style="width: 90px; text-align: right;">
            <span class="sr-only">Actions</span>
          </th>
        <% end %>
      </tr>
    </thead>

    <tbody>
      <% resources.each do |resource| %>
        <tr
          tabindex="0"
          <% if existing_action?(collection_presenter.resource_name, :show) %>
            <%= %(role=link data-url=#{polymorphic_path([namespace, resource])}) %>
          <% end %>
        >
          <% collection_presenter.attributes_for(resource).each do |attribute| %>
            <td class="text-foreground">
              <% if authorized_action?(resource, :show) %>
                <a
                  href="<%= polymorphic_path([namespace, resource]) %>"
                  class="block hover:text-primary transition-colors font-medium"
                >
                  <%= render_field attribute %>
                </a>
              <% else %>
                <%= render_field attribute %>
              <% end %>
            </td>
          <% end %>

          <% if has_actions %>
            <td style="text-align: right;">
              <div class="flex items-center justify-end gap-1">
                <% if existing_action?(collection_presenter.resource_name, :edit) %>
                  <%= link_to(
                    [:edit, namespace, resource],
                    class: "inline-flex items-center justify-center size-8 rounded-md text-muted-foreground hover:text-primary hover:bg-accent transition-colors",
                    data: { tooltip: t("administrate.actions.edit") }
                  ) do %>
                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                  <% end if authorized_action?(resource, :edit) %>
                <% end %>

                <% if existing_action?(collection_presenter.resource_name, :destroy) %>
                  <%= link_to(
                    [namespace, resource],
                    class: "inline-flex items-center justify-center size-8 rounded-md text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors",
                    method: :delete,
                    data: { confirm: t("administrate.actions.confirm"), tooltip: t("administrate.actions.destroy") }
                  ) do %>
                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                  <% end if authorized_action?(resource, :destroy) %>
                <% end %>
              </div>
            </td>
          <% end %>
        </tr>
      <% end %>

      <% if resources.empty? %>
        <tr>
          <td colspan="<%= collection_presenter.attribute_types.count + (has_actions ? 1 : 0) %>"
              class="px-4 py-12 text-center text-sm text-muted-foreground">
            <svg class="size-8 mx-auto mb-2 opacity-40 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
            No <%= display_resource_name(collection_presenter.resource_name) %> found.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

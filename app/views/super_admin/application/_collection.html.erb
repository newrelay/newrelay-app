<%#
# Collection
# Displays a collection of resources in an HTML table according to Design System NR rules.
%>
<%
  attr_types = collection_presenter.attribute_types
  skip_avatar_col = (attr_types.key?(:avatar_url) || attr_types.key?('avatar_url')) && (attr_types.key?(:name) || attr_types.key?('name'))
  visible_attr_count = attr_types.count - (skip_avatar_col ? 1 : 0)
  has_actions = existing_action?(collection_presenter.resource_name, :edit) || existing_action?(collection_presenter.resource_name, :destroy)
  col_count = visible_attr_count + (has_actions ? 1 : 0)
  resource_key = collection_presenter.resource_name.to_s
  text_row_actions = %w[agent_bot platform_app].include?(resource_key)
  table_initials = lambda do |name|
    chars = name.to_s.split(/\s+/).filter_map { |word| word[0] }.first(2)
    chars.join.upcase.presence || '?'
  end
%>

<div class="table-card">
  <table aria-labelledby="<%= table_title %>">
    <thead>
      <tr>
        <% attr_types.each do |attr_name, attr_type| %>
          <% next if skip_avatar_col && attr_name.to_sym == :avatar_url %>
          <th
            scope="col"
            role="columnheader"
            aria-sort="<%= sort_order(collection_presenter.ordered_html_class(attr_name)) %>"
          >
            <%= link_to(
              sanitized_order_params(page, collection_field_name).merge(
                collection_presenter.order_params_for(attr_name, key: collection_field_name)
              ),
              class: "inline-flex items-center gap-1.5 hover:text-primary transition-colors font-medium text-foreground"
            ) do %>
              <span>
                <% column_label = t(
                  "helpers.label.#{collection_presenter.resource_name}.#{attr_name}",
                  default: attr_name.to_s,
                ).titleize %>
                <%= attr_name.to_s == 'id' ? 'ID' : column_label %>
              </span>
              <% if collection_presenter.ordered_by?(attr_name) %>
                <svg class="size-3.5 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= collection_presenter.ordered_html_class(attr_name) == 'asc' ? '<path d="m18 15-6-6-6 6"/>'.html_safe : '<path d="m6 9 6 6 6-6"/>'.html_safe %></svg>
              <% else %>
                <svg class="size-3.5 text-muted-foreground shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
              <% end %>
            <% end %>
          </th>
        <% end %>

        <% if has_actions %>
          <th scope="col" class="w-[90px] text-right">
            <span class="sr-only">Actions</span>
          </th>
        <% end %>
      </tr>
    </thead>

    <tbody>
      <% resources.each do |resource| %>
        <% path_resource = resource.is_a?(User) ? resource.becomes(User) : resource %>
        <tr
          tabindex="0"
          <% if existing_action?(collection_presenter.resource_name, :show) %>
            <%= %(role=link data-url=#{polymorphic_path([namespace, path_resource])}) %>
          <% end %>
        >
          <% collection_presenter.attributes_for(resource).each_with_index do |attribute, index| %>
            <% attr_name = (attribute.try(:attribute) || attribute.name).to_s %>
            <% next if skip_avatar_col && attr_name == 'avatar_url' %>
            <% is_name = attr_name == 'name' %>
            <% is_status = attr_name == 'status' %>
            <% is_account = attr_name == 'account' %>
            <td class="<%= index.zero? ? 'text-muted-foreground' : 'text-foreground' %>">
              <% if is_name && resource.respond_to?(:avatar_url) %>
                <div class="table-user-cell">
                  <div class="table-avatar">
                    <% if resource.avatar_url.present? %>
                      <%= image_tag resource.avatar_url, alt: '', class: 'size-full object-cover' %>
                    <% else %>
                      <span class="table-avatar-placeholder"><%= table_initials.call(resource.try(:name)) %></span>
                    <% end %>
                  </div>
                  <% if authorized_action?(path_resource, :show) %>
                    <a href="<%= polymorphic_path([namespace, path_resource]) %>" class="font-semibold hover:text-primary transition-colors">
                      <%= render_field attribute %>
                    </a>
                  <% else %>
                    <span class="font-semibold"><%= render_field attribute %></span>
                  <% end %>
                </div>
              <% elsif is_account && attribute.data.respond_to?(:name) %>
                <div class="table-user-cell">
                  <div class="table-avatar">
                    <span class="table-avatar-placeholder"><%= table_initials.call(attribute.data.name) %></span>
                  </div>
                  <span class="font-medium"><%= render_field attribute %></span>
                </div>
              <% elsif is_status %>
                <span class="<%= attribute.data.to_s == 'suspended' ? 'text-muted-foreground font-medium' : 'status-text-active' %>">
                  <%= render_field attribute %>
                </span>
              <% elsif attr_name == 'banner_type' %>
                <span class="badge <%= case attribute.data.to_s
                                       when 'warning' then 'badge-warning'
                                       when 'error' then 'badge-destructive'
                                       else 'badge-indigo'
                                       end %>">
                  <%= render_field attribute %>
                </span>
              <% elsif attr_name == 'active' && resource_key == 'platform_banner' %>
                <span class="badge <%= attribute.data ? 'badge-success' : 'badge-muted' %>">
                  <%= attribute.data ? 'Active' : 'Inactive' %>
                </span>
              <% elsif attr_name == 'type' && attribute.data.to_s == 'SuperAdmin' %>
                <span class="badge badge-indigo">Super Admin</span>
              <% elsif is_name && authorized_action?(path_resource, :show) %>
                <a href="<%= polymorphic_path([namespace, path_resource]) %>" class="font-semibold hover:text-primary transition-colors">
                  <%= render_field attribute %>
                </a>
              <% else %>
                <%= render_field attribute %>
              <% end %>
            </td>
          <% end %>

          <% if has_actions %>
            <td class="text-right">
              <% if text_row_actions %>
                <div class="row-actions row-actions-text">
                  <% if existing_action?(collection_presenter.resource_name, :edit) && authorized_action?(path_resource, :edit) %>
                    <%= link_to t("administrate.actions.edit"),
                          [:edit, namespace, path_resource],
                          class: "btn btn-outline btn-sm" %>
                  <% end %>
                  <% if existing_action?(collection_presenter.resource_name, :destroy) && authorized_action?(path_resource, :destroy) %>
                    <%= link_to "Delete",
                          [namespace, path_resource],
                          method: :delete,
                          class: "btn btn-danger-soft btn-sm",
                          data: { confirm: t("administrate.actions.confirm") } %>
                  <% end %>
                </div>
              <% else %>
              <div class="row-actions">
                <% if existing_action?(collection_presenter.resource_name, :edit) %>
                  <%= link_to(
                    [:edit, namespace, path_resource],
                    class: "action-icon-btn",
                    data: { tooltip: t("administrate.actions.edit") }
                  ) do %>
                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                  <% end if authorized_action?(path_resource, :edit) %>
                <% end %>

                <% if existing_action?(collection_presenter.resource_name, :destroy) %>
                  <%= link_to(
                    [namespace, path_resource],
                    class: "action-icon-btn danger",
                    method: :delete,
                    data: { confirm: t("administrate.actions.confirm"), tooltip: "Delete" }
                  ) do %>
                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                  <% end if authorized_action?(path_resource, :destroy) %>
                <% end %>
              </div>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>

      <% if resources.empty? %>
        <tr>
          <td colspan="<%= col_count %>">
            <div class="empty-table-state">
              <div class="empty-icon-wrap">
                <svg class="empty-state-icon" xmlns="http://www.w3.org/2000/svg" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
              </div>
              <p class="empty-state-text">No <%= display_resource_name(collection_presenter.resource_name) %> found.</p>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

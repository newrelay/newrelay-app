<li class="relative">
  <% text_class_name = current_page?(url) ? 'text-sidebar-primary font-medium bg-sidebar-primary/10' : 'text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground' %>
  <%= link_to(url, class: text_class_name + " flex h-8 min-w-0 w-full items-center gap-3 overflow-hidden rounded-md px-2 text-sm transition-colors outline-none") do %>
    <span class="<%= icon %> size-4 shrink-0 text-muted-foreground <%= current_page?(url) ? 'text-sidebar-primary' : '' %>" aria-hidden="true"></span>
    <span class="truncate"><%= label %></span>
  <% end %>
</li>

<% settings_active = open || current_page?(super_admin_settings_path) %>
<li class="sidebar-menu-item sidebar-item-wrap <%= 'open' if settings_active %>" id="settingsMenuItem" data-slot="sidebar-menu-item">
  <button aria-expanded="<%= settings_active ? 'true' : 'false' %>" class="sidebar-menu-btn <%= 'active' if settings_active %>" id="settingsToggleBtn">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings" style="width:16px;height:16px;"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
    <span class="flex-1">Settings</span>
    <svg class="sidebar-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
  </button>
  <div class="sidebar-submenu-wrapper">
    <div class="sidebar-submenu-inner">
      <ul class="sidebar-menu-sub" data-slot="sidebar-menu-sub">
        <% settings_pages.each_with_index do |(_feature_key, attrs), index| %>
          <% is_last = index == settings_pages.length - 1 %>
          <% url = super_admin_app_config_url(config: attrs['config_key']) %>
          <li class="sidebar-sub-item">
            <% unless is_last %>
              <div class="tree-line-v"></div>
            <% end %>
            <div class="tree-line-corner"></div>
            <div class="pl-3">
              <%= link_to url, class: "sidebar-sub-link #{'active' if current_page?(url)}" do %>
                <span><%= attrs['name'] %></span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
  <!-- Flyout Card for Collapsed Mode -->
  <div class="sidebar-flyout sidebar-flyout-card">
    <div class="sidebar-flyout-header">Settings</div>
    <div class="sidebar-flyout-divider"></div>
    <div class="sidebar-flyout-body">
      <% settings_pages.each do |(_feature_key, attrs)| %>
        <% url = super_admin_app_config_url(config: attrs['config_key']) %>
        <%= link_to attrs['name'], url, class: "sidebar-flyout-link #{'active' if current_page?(url)}" %>
      <% end %>
    </div>
  </div>
</li>


<%#
# Edit

This view is the template for the edit page.

It displays a header, and renders the `_form` partial to do the heavy lifting.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Form][1].
  Contains helper methods to help display a form,
  and knows which attributes should be displayed in the resource's form.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Form
%>

<% content_for(:title) { t("administrate.actions.edit_resource", name: page.page_title) } %>

<div class="space-y-6">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to polymorphic_path([namespace, page.resource_name.to_s.pluralize.to_sym]), class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-input bg-background text-sm font-medium text-foreground hover:bg-accent hover:border-[#cac7f7] transition-colors" do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back</span>
    <% end %>
    <h1 class="page-title">
      <%= content_for(:title) %>
    </h1>
    <% if accessible_action?(page.resource, :show) %>
      <div class="ml-auto">
        <%= link_to(
          t("administrate.actions.show_resource", name: page.page_title),
          [namespace, page.resource],
          class: "inline-flex h-9 items-center justify-center rounded-md border border-input bg-background px-4 text-sm font-medium text-foreground shadow-xs hover:bg-accent hover:border-[#cac7f7] transition-colors",
        ) %>
      </div>
    <% end %>
  </div>

  <section class="form-card rounded-xl border border-border bg-card p-6 md:p-8 shadow-xs w-full">
    <%= render "form", page: page %>
  </section>
</div>

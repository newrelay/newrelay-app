<% content_for(:title) { t("administrate.actions.edit_resource", name: page.page_title) } %>

<div class="space-y-6 w-full">
  <div class="page-header">
    <h1 class="page-title">
      <%= content_for(:title) %>
    </h1>
    <div class="page-actions">
      <%= link_to polymorphic_path([namespace, page.resource_name.to_s.pluralize.to_sym]), class: "btn btn-outline" do %>
        <span>Back</span>
      <% end %>
      <% if accessible_action?(page.resource, :show) %>
        <%= link_to(
          t("administrate.actions.show_resource", name: page.page_title),
          [namespace, page.resource],
          class: "btn btn-outline",
        ) %>
      <% end %>
    </div>
  </div>

  <section class="form-card">
    <%= render "form", page: page %>
  </section>
</div>

<%#
# Show

This view is the template for the show page.
It renders the attributes of a resource,
as well as a link to its edit page.
%>

<% content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) } %>

<div class="space-y-6">
  <header class="page-header">
    <%= link_to polymorphic_path([namespace, page.resource_name.to_s.pluralize.to_sym]), class: "btn btn-outline" do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back</span>
    <% end %>
    <h1 class="page-title">
      <%= content_for(:title) %>
    </h1>

    <div class="page-actions">
      <%= link_to(
        [:edit, namespace, page.resource],
        class: "btn btn-primary"
      ) do %>
        <span class="i-lucide-pen-line size-4"></span>
        <%= t("administrate.actions.edit") %>
      <% end if accessible_action?(page.resource, :edit) %>

      <%= link_to(
        [namespace, page.resource],
        class: "btn btn-danger-soft",
        method: :delete,
        data: { confirm: t("administrate.actions.confirm") }
      ) do %>
        <span class="i-lucide-trash-2 size-4"></span>
        Delete
      <% end if accessible_action?(page.resource, :destroy) %>
    </div>
  </header>

  <section class="show-details-card">
    <div class="show-details-inner">
      <% page.attributes.each do |title, attributes| %>
        <% if title.present? %>
          <h3 class="show-section-title">
            <%= t "helpers.label.#{page.resource_name}.#{title}", default: title %>
          </h3>
        <% end %>

        <% attributes.each do |attribute| %>
          <div class="show-row">
            <div class="show-label" id="<%= attribute.name %>">
              <%= t(
                "helpers.label.#{resource_name}.#{attribute.name}",
                default: page.resource.class.human_attribute_name(attribute.name),
              ) %>
            </div>
            <div class="show-value attribute-data attribute-data--<%=attribute.html_class%>">
              <% if attribute.name.to_s == 'status' %>
                <span class="<%= attribute.data.to_s == 'suspended' ? 'text-muted-foreground font-medium' : 'status-text-active' %>">
                  <%= render_field attribute, page: page %>
                </span>
              <% elsif super_admin_blank_value?(attribute.data) %>
                <span class="text-muted-foreground">—</span>
              <% else %>
                <%= render_field attribute, page: page %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
</div>

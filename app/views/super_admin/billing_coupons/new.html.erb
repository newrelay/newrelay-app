<%#
# New Billing Coupon
%>

<% content_for(:title) do %>
  <%= t('administrate.actions.new_resource', name: display_resource_name(page.resource_name, count: 1)) %>
<% end %>

<div class="space-y-6 w-full">
  <div class="page-header flex items-center justify-between mb-6">
    <h1 class="page-title">
      <%= content_for(:title) %>
    </h1>
    <div class="page-actions">
      <%= link_to :back, class: "btn btn-outline" do %>
        <span><%= t('administrate.actions.back') %></span>
      <% end %>
    </div>
  </div>

  <section class="form-card">
    <%= render 'form', page: page %>
  </section>
</div>

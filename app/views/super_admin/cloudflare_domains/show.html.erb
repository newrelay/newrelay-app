<% content_for(:title) { "Cloudflare Domains" } %>

<div class="space-y-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="page-title">Cloudflare Domains</h1>
  </div>

  <% if @error.present? %>
    <div class="rounded-md border border-border bg-muted/30 px-4 py-3 text-sm text-muted-foreground">
      <%= @error %>
    </div>
  <% end %>

  <div class="table-card">
    <table>
      <thead>
        <tr>
          <th>Hostname</th>
          <th>Status</th>
          <th>SSL</th>
          <th>Created</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @hostnames.blank? %>
          <tr><td colspan="5" class="text-muted-foreground text-center py-6">No custom hostnames found on Cloudflare.</td></tr>
        <% end %>
        <% @hostnames.each do |h| %>
          <tr>
            <td class="font-medium text-foreground break-all"><%= h['hostname'] %></td>
            <td><%= h['status'] %></td>
            <td><%= h.dig('ssl', 'status') %></td>
            <td class="text-muted-foreground"><%= h['created_at'] %></td>
            <td style="text-align: right;">
              <%= button_to "Delete",
                    super_admin_cloudflare_domains_path(hostname: h['hostname']),
                    method: :delete,
                    form: { data: { turbo_confirm: "Delete #{h['hostname']} from Cloudflare?" } },
                    data: { confirm: "Delete #{h['hostname']} from Cloudflare?" },
                    class: "inline-flex h-8 items-center justify-center rounded-md bg-destructive px-3 text-xs font-medium text-destructive-foreground hover:bg-destructive/90 transition-colors" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>


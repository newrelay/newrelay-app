<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="w-full h-full">
  <head>
    <title><%= t('super_admin.sessions.title') %> | NewRelay</title>
    <meta charset="utf-8">
    <meta name="viewport" content="initial-scale=1">
    <script>
      if (localStorage.getItem('nr-dark') === 'true') {
        document.documentElement.classList.add('dark');
      }
    </script>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
    <%= csrf_meta_tags %>
    <link rel="icon" type="image/svg+xml" href="/brand-assets/logo_thumbnail.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  </head>
  <body class="antialiased relative w-full h-full bg-background text-foreground" data-relay="true">
    <div class="min-h-screen w-full flex items-center justify-center px-4">
      <div class="w-full max-w-[400px]">
        <div class="flex flex-col items-center mb-8 gap-3">
          <div class="bg-primary text-primary-foreground flex size-10 items-center justify-center rounded-xl text-lg font-bold">
            N
          </div>
          <div class="text-center">
            <h1 class="text-[22px] font-semibold tracking-tight text-foreground"><%= t('super_admin.sessions.heading') %></h1>
            <p class="mt-1 text-[14px] font-normal text-muted-foreground"><%= t('super_admin.sessions.subtitle') %></p>
          </div>
        </div>

        <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
          <%= form_for(resource, as: resource_name, url: '/super_admin/sign_in', html: { class: 'flex flex-col gap-4' }) do |f| %>
            <% if flash[:error].present? %>
              <div class="flex items-start gap-2.5 rounded-lg bg-destructive/10 border border-destructive/20 p-3 text-sm text-destructive">
                <span class="i-lucide-alert-circle size-4 mt-0.5 shrink-0"></span>
                <%= flash[:error] %>
              </div>
            <% end %>

            <div class="flex flex-col gap-1.5">
              <label for="super_admin_email" class="block text-[13.5px] font-medium leading-normal text-foreground">
                <%= t('super_admin.sessions.email_label') %>
              </label>
              <%= f.email_field :email, autofocus: true, autocomplete: "email",
                  placeholder: t('super_admin.sessions.email_placeholder'),
                  class: "form-input" %>
            </div>

            <div class="flex flex-col gap-1.5">
              <div class="flex items-center justify-between gap-2">
                <label for="super_admin_password" class="block text-[13.5px] font-medium leading-normal text-foreground">
                  <%= t('super_admin.sessions.password_label') %>
                </label>
                <span class="text-[13px] font-medium text-primary">
                  <%= t('super_admin.sessions.forgot_password') %>
                </span>
              </div>
              <div class="relative">
                <%= f.password_field :password, autocomplete: "current-password",
                    placeholder: t('super_admin.sessions.password_placeholder'),
                    class: "form-input pr-10" %>
                <button
                  type="button"
                  class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground hover:text-foreground"
                  data-password-toggle
                  data-label-show="<%= t('super_admin.sessions.show_password') %>"
                  data-label-hide="<%= t('super_admin.sessions.hide_password') %>"
                  aria-label="<%= t('super_admin.sessions.show_password') %>"
                >
                  <span class="i-lucide-eye size-4" data-password-icon="show"></span>
                  <span class="i-lucide-eye-off size-4 hidden" data-password-icon="hide"></span>
                </button>
              </div>
            </div>

            <label class="flex items-center gap-3 cursor-pointer">
              <span class="custom-checkbox">
                <%= f.check_box :remember_me, { checked: true } %>
                <span class="checkmark"></span>
              </span>
              <span class="text-[14px] text-foreground"><%= t('super_admin.sessions.remember_me') %></span>
            </label>

            <button type="submit" class="btn btn-primary w-full !h-10 cursor-pointer">
              <%= t('super_admin.sessions.submit') %>
            </button>
          <% end %>
        </div>

        <%
          instance_ok = begin
            ActiveRecord::Base.connection.active?
          rescue StandardError
            false
          end
          edition = ChatwootApp.enterprise? ? t('super_admin.sessions.edition_enterprise') : t('super_admin.sessions.edition_community')
          status_label = instance_ok ? t('super_admin.sessions.status_operational') : t('super_admin.sessions.status_degraded')
        %>
        <div class="mt-8 flex flex-col items-center gap-2 text-[12px] text-muted-foreground">
          <div class="flex items-center gap-2">
            <span class="size-1.5 shrink-0 rounded-full <%= instance_ok ? 'bg-[var(--success)]' : 'bg-destructive' %>"></span>
            <span>
              <%= t('super_admin.sessions.instance_line', status: status_label, version: Chatwoot.config[:version], edition: edition) %>
            </span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="i-lucide-lock size-3.5 shrink-0"></span>
            <span><%= t('super_admin.sessions.tls_line') %></span>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

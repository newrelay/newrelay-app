<div class="flex flex-col gap-1.5">
  <p class="text-[13.5px] font-medium leading-normal text-foreground">
    <%= t('super_admin.email_templates.audience') %>
  </p>
  <div class="flex flex-wrap gap-2">
    <%= link_to t('super_admin.email_templates.our_mail'), audience_path(false),
        class: "btn btn-sm #{custom_brand? ? 'btn-outline' : 'btn-primary'}" %>
    <%= link_to t('super_admin.email_templates.custom_brand_mail'), audience_path(true),
        class: "btn btn-sm #{custom_brand? ? 'btn-primary' : 'btn-outline'}" %>
  </div>
  <p class="text-[12px] text-muted-foreground"><%= t('super_admin.email_templates.audience_help') %></p>
</div>

<% content_for(:title) { t('super_admin.email_templates.edit_title', name: @entry.title) } %>

<div class="space-y-6">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t('super_admin.email_templates.edit_title', name: @entry.title) %></h1>
      <p class="text-[13.5px] text-muted-foreground mt-1"><%= t('super_admin.email_templates.edit_description') %></p>
    </div>
    <div class="page-actions">
      <%= link_to t('super_admin.email_templates.cancel'), super_admin_email_template_path(@entry.key), class: 'btn btn-outline' %>
    </div>
  </div>

  <%= form_with url: super_admin_email_template_path(@entry.key), method: :patch, local: true do %>
    <div class="show-sub-card overflow-hidden p-0">
      <div class="show-sub-header px-6 pt-5 mx-6">
        <h2 class="show-sub-title"><%= t('super_admin.email_templates.body') %></h2>
        <p class="show-sub-subtitle"><%= @entry.relative_path %></p>
      </div>
      <div class="px-6 pb-5 flex flex-col gap-1.5">
        <label for="email_template_body" class="field-unit__label"><%= t('super_admin.email_templates.body') %></label>
        <%= text_area_tag 'email_template[body]', @body, id: 'email_template_body', rows: 24, class: 'form-input font-mono text-[13px]' %>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-3 border-t border-border/40 px-6 py-4">
        <%= submit_tag t('super_admin.email_templates.save'), class: 'btn btn-primary cursor-pointer' %>
      </div>
    </div>
  <% end %>

  <% if @override.present? %>
    <%= button_to t('super_admin.email_templates.reset_action'), super_admin_email_template_path(@entry.key), method: :delete,
        class: 'btn btn-outline',
        data: { confirm: t('super_admin.email_templates.reset_confirm') } %>
  <% end %>
</div>

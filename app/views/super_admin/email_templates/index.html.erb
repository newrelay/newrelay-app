<% content_for(:title) { t('super_admin.email_templates.title') } %>

<div class="space-y-6">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t('super_admin.email_templates.title') %></h1>
      <p class="text-[13.5px] text-muted-foreground mt-1"><%= t('super_admin.email_templates.description') %></p>
    </div>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to t('super_admin.email_templates.all_categories'), super_admin_email_templates_path,
        class: "btn btn-sm #{params[:category].blank? ? 'btn-primary' : 'btn-outline'}" %>
    <% @categories.each do |category| %>
      <%= link_to category, super_admin_email_templates_path(category: category),
          class: "btn btn-sm #{params[:category] == category ? 'btn-primary' : 'btn-outline'}" %>
    <% end %>
  </div>

  <div class="table-card">
    <div class="table-overflow-wrap">
      <table aria-labelledby="page-title">
        <thead>
          <tr>
            <th scope="col"><%= t('super_admin.email_templates.columns.name') %></th>
            <th scope="col"><%= t('super_admin.email_templates.columns.category') %></th>
            <th scope="col"><%= t('super_admin.email_templates.columns.format') %></th>
            <th scope="col"><%= t('super_admin.email_templates.columns.status') %></th>
            <th scope="col" class="w-[180px] text-right"><span class="sr-only"><%= t('super_admin.email_templates.columns.actions') %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @templates.each do |entry, override| %>
            <tr>
              <td>
                <div class="font-medium text-foreground"><%= entry.title %></div>
                <div class="text-[12px] text-muted-foreground font-mono mt-0.5"><%= entry.relative_path %></div>
              </td>
              <td class="text-muted-foreground"><%= entry.category %></td>
              <td class="text-muted-foreground"><%= entry.format.upcase %></td>
              <td>
                <% if override.present? %>
                  <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-[12px] font-medium text-primary">
                    <%= t('super_admin.email_templates.status.overridden') %>
                  </span>
                <% else %>
                  <span class="text-muted-foreground"><%= t('super_admin.email_templates.status.default') %></span>
                <% end %>
              </td>
              <td class="text-right">
                <div class="flex justify-end gap-2">
                  <%= link_to t('super_admin.email_templates.preview'), preview_super_admin_email_template_path(entry.key), class: 'btn btn-outline btn-sm' %>
                  <%= link_to t('super_admin.email_templates.view'), super_admin_email_template_path(entry.key), class: 'btn btn-outline btn-sm' %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

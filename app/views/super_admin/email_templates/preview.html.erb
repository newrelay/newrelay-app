<% content_for(:title) { t('super_admin.email_templates.preview_title', name: @entry.title) } %>

<div class="space-y-6">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t('super_admin.email_templates.preview_title', name: @entry.title) %></h1>
      <p class="text-[13.5px] text-muted-foreground mt-1">
        <% if custom_brand? %>
          <%= t('super_admin.email_templates.preview_description_brand') %>
        <% else %>
          <%= t('super_admin.email_templates.preview_description') %>
        <% end %>
      </p>
    </div>
    <div class="page-actions">
      <%= link_to t('super_admin.email_templates.back'), super_admin_email_templates_path(email_template_scope), class: 'btn btn-outline' %>
      <%= link_to t('super_admin.email_templates.view'), super_admin_email_template_path(@entry.key, email_template_scope), class: 'btn btn-outline' %>
      <% if @entry.editable %>
        <%= link_to t('super_admin.email_templates.edit'), edit_super_admin_email_template_path(@entry.key, email_template_scope), class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>

  <%= render 'audience_pills' %>

  <div class="show-sub-card p-0">
    <iframe sandbox="allow-same-origin" class="email-template-preview-frame" title="<%= t('super_admin.email_templates.preview_title', name: @entry.title) %>" src="<%= preview_super_admin_email_template_path(@entry.key, email_template_scope.merge(raw: 1)) %>"></iframe>
  </div>
</div>

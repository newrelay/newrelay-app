<% content_for(:title) do %>
  Enterprise Inquiries
<% end %>

<div class="space-y-6">
  <div class="page-header">
    <div>
      <h1 class="page-title">Enterprise Inquiries</h1>
      <p class="text-[13.5px] text-muted-foreground mt-1">Review incoming enterprise plan upgrade requests, generate custom payment checkout links, and process contracts</p>
    </div>
  </div>

  <% if notice.present? %>
    <div class="mb-4 rounded-lg border border-success/20 bg-success/10 px-4 py-3 text-sm text-success">
      <%= notice %>
    </div>
  <% end %>
  <% if alert.present? %>
    <div class="mb-4 rounded-lg border border-destructive/20 bg-destructive/10 px-4 py-3 text-sm text-destructive">
      <%= alert %>
    </div>
  <% end %>

  <% if @accounts.empty? %>
    <p class="text-muted-foreground">No Enterprise plan inquiries have been submitted yet.</p>
  <% else %>
    <div class="table-card mb-6">
      <table>
        <thead>
          <tr>
            <th scope="col">Account</th>
            <th scope="col">Requested by</th>
            <th scope="col">Seats</th>
            <th scope="col">Features</th>
            <th scope="col">Message</th>
            <th scope="col">Requested at</th>
            <th scope="col">Status</th>
            <th scope="col">Plan</th>
            <th scope="col">Payment link</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @accounts.each do |account| %>
            <% inquiry = Enterprise::Billing::EnterpriseInquiryAttributes.enterprise_inquiry(account) || {} %>
            <% contract = account.enterprise_contract %>
            <% stored_attrs = Enterprise::Billing::EnterpriseInquiryAttributes.stored_custom_attributes(account) %>
            <% billing_symbol = stored_attrs['billing_country'].to_s.upcase == 'IN' ? '₹' : '$' %>
            <% default_provider = Enterprise::Billing::PaymentGatewayRegistry.resolve_provider(country: stored_attrs['billing_country']) %>
            <% features_text = Array(inquiry['desired_features']).join(', ') %>
            <% open_inquiry = inquiry['processed_at'].blank? && inquiry['rejected_at'].blank? %>
            <tr>
              <td class="font-medium text-foreground whitespace-nowrap">
                <%= link_to "#{account.name} ##{account.id}", [namespace, account], class: 'hover:underline' %>
              </td>
              <td class="text-muted-foreground">
                <div><%= inquiry['requested_by'].presence || '—' %></div>
                <% if inquiry['company_size'].present? %>
                  <div class="text-xs"><%= inquiry['company_size'] %> size</div>
                <% end %>
              </td>
              <td class="text-muted-foreground"><%= inquiry['team_size'].presence || '—' %></td>
              <td class="text-muted-foreground max-w-[160px] truncate" title="<%= features_text %>">
                <%= features_text.presence || '—' %>
              </td>
              <td class="text-muted-foreground max-w-[140px] truncate" title="<%= inquiry['message'] %>">
                <%= inquiry['message'].presence || '—' %>
              </td>
              <td class="text-muted-foreground whitespace-nowrap">
                <%= inquiry['requested_at'].present? ? Time.zone.parse(inquiry['requested_at']).strftime('%d %b %Y %H:%M') : '—' %>
              </td>
              <td>
                <% if inquiry['rejected_at'].present? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-destructive/10 text-destructive">Rejected</span>
                <% elsif inquiry['processed_at'].present? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Processed</span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium badge-warning">Pending</span>
                <% end %>
              </td>
              <td>
                <% if contract.present? %>
                  <% if contract.contract_end_date < Time.zone.today %>
                    <span class="text-destructive font-medium">Expired</span>
                  <% elsif contract.contract_start_date > Time.zone.today %>
                    <span class="status-warning">Upcoming</span>
                  <% else %>
                    <span class="status-text-active">Active</span>
                  <% end %>
                  <div class="text-xs text-muted-foreground mt-0.5 whitespace-nowrap">
                    <%= contract.currency %> <%= number_with_precision(contract.negotiated_price, precision: 2) %>/<%= contract.billing_interval == 'annual' ? 'yr' : 'mo' %>
                    <% if contract.contract_end_date.present? %>
                      until <%= contract.contract_end_date.strftime('%d %b %Y') %>
                    <% end %>
                  </div>
                  <%= link_to 'Edit plan', [:edit, namespace, contract], class: 'text-xs text-primary hover:underline' %>
                <% else %>
                  <span class="text-muted-foreground text-xs">No plan yet</span>
                <% end %>
              </td>
              <td class="min-w-[220px]">
                <% if inquiry['payment_link_sent_at'].present? %>
                  <div class="text-xs text-success">
                    Sent (<%= billing_symbol %><%= inquiry['payment_link_amount'] %>/mo)
                    <% if inquiry['payment_link_sent_by'].present? %>
                      by <%= inquiry['payment_link_sent_by'] %>
                    <% end %>
                    on <%= Time.zone.parse(inquiry['payment_link_sent_at']).strftime('%d %b %Y') %>
                  </div>
                <% else %>
                  <%= form_tag send_payment_link_super_admin_enterprise_inquiry_path(account), method: :post, class: 'flex flex-col gap-1.5' do %>
                    <div class="relative">
                      <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-xs text-muted-foreground"><%= billing_symbol %></span>
                      <%= number_field_tag :monthly_price, contract&.negotiated_price, min: 1, step: 0.01, placeholder: 'e.g. 499', required: true, class: 'form-input !pl-6' %>
                    </div>
                    <%= select_tag :payment_provider,
                        options_for_select(
                          @payment_gateways.map { |gateway|
                            ["#{Enterprise::Billing::PaymentGatewayRegistry.label_for(gateway['id'])} (#{Enterprise::Billing::PaymentGatewayRegistry.currency_for(gateway['id']).upcase})", gateway['id']]
                          },
                          default_provider
                        ),
                        class: 'form-input' %>
                    <%= submit_tag 'Send link', class: 'btn btn-primary btn-sm reset-base cursor-pointer w-full' %>
                  <% end %>
                <% end %>
              </td>
              <td class="min-w-[180px]">
                <div class="flex flex-col gap-1.5">
                  <% if open_inquiry %>
                    <%= button_to 'Mark processed', mark_processed_super_admin_enterprise_inquiry_path(account), method: :post, class: 'btn btn-outline btn-sm reset-base w-full' %>
                    <%= form_tag reject_super_admin_enterprise_inquiry_path(account), method: :post, class: 'flex flex-col gap-1.5' do %>
                      <%= text_field_tag :note, nil, placeholder: 'Rejection reason', class: 'form-input' %>
                      <%= submit_tag 'Reject', class: 'btn btn-danger btn-sm reset-base cursor-pointer w-full' %>
                    <% end %>
                  <% elsif inquiry['rejected_at'].present? %>
                    <div class="text-xs text-muted-foreground">
                      by <%= inquiry['rejected_by'] %>
                      <% if inquiry['rejection_note'].present? %>
                        <span class="block truncate" title="<%= inquiry['rejection_note'] %>">“<%= inquiry['rejection_note'] %>”</span>
                      <% end %>
                    </div>
                  <% end %>
                  <%= button_to 'Delete', super_admin_enterprise_inquiry_path(account), method: :delete, data: { confirm: 'Delete this inquiry? This cannot be undone.' }, class: 'btn btn-danger-soft btn-sm reset-base w-full' %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

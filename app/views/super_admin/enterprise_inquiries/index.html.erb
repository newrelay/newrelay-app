<% content_for(:title) do %>
  Enterprise Inquiries
<% end %>

<div class="space-y-6">
  <div class="page-header">
    <div>
      <h1 class="page-title">Enterprise Inquiries</h1>
      <p class="text-[13.5px] text-muted-foreground mt-1">Lead captures and demo requests waiting for review</p>
    </div>
  </div>

  <% if notice.present? %>
    <div class="mb-4 rounded-lg border border-success/20 bg-success/10 px-4 py-3 text-sm text-success">
      <%= notice %>
    </div>
  <% end %>
  <% if alert.present? %>
    <div class="mb-4 rounded-lg border border-destructive/20 bg-destructive/10 px-4 py-3 text-sm text-destructive">
      <%= alert %>
    </div>
  <% end %>

  <% if @accounts.empty? %>
    <p class="text-muted-foreground">No Enterprise plan inquiries have been submitted yet.</p>
  <% else %>
    <div class="table-card mb-6">
      <table>
        <thead>
          <tr>
            <th scope="col">Account</th>
            <th scope="col">Requested by</th>
            <th scope="col">Company</th>
            <th scope="col">Needs</th>
            <th scope="col">Status</th>
            <th scope="col">Plan</th>
            <th class="text-right" scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @accounts.each do |account| %>
            <% inquiry = Enterprise::Billing::EnterpriseInquiryAttributes.enterprise_inquiry(account) || {} %>
            <tr>
              <td class="font-medium text-foreground">
                <%= link_to "##{account.id} #{account.name}", [namespace, account], class: "hover:underline" %>
                <div class="text-xs text-muted-foreground mt-0.5">
                  <%= inquiry['requested_at'].present? ? Time.zone.parse(inquiry['requested_at']).strftime('%d %b %Y, %H:%M') : '—' %>
                </div>
              </td>
              <td class="text-muted-foreground"><%= inquiry['requested_by'].presence || '—' %></td>
              <td class="text-muted-foreground">
                <%= inquiry['company_size'].presence || '—' %> employees<br>
                <%= inquiry['team_size'].presence || '—' %> seats
              </td>
              <td class="text-muted-foreground max-w-[200px] truncate" title="<%= Array(inquiry['desired_features']).join(', ') %>">
                <%= Array(inquiry['desired_features']).join(', ').presence || '—' %>
              </td>
              <td>
                <% if inquiry['rejected_at'].present? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-destructive/10 text-destructive">Rejected</span>
                <% elsif inquiry['processed_at'].present? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-success/10 text-success">Processed</span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium badge-warning">Pending</span>
                <% end %>
              </td>
              <td>
                <% contract = account.enterprise_contract %>
                <% if contract.present? %>
                  <% if contract.contract_end_date < Time.zone.today %>
                    <span class="text-destructive font-medium">Expired</span>
                  <% elsif contract.contract_start_date > Time.zone.today %>
                    <span class="status-warning">Upcoming</span>
                  <% else %>
                    <span class="status-text-active">Active</span>
                  <% end %>
                  <div class="text-xs text-muted-foreground mt-0.5"><%= contract.currency %> <%= number_with_precision(contract.negotiated_price, precision: 2) %>/<%= contract.billing_interval == 'annual' ? 'yr' : 'mo' %></div>
                <% else %>
                  <span class="text-muted-foreground text-xs">No plan yet</span>
                <% end %>
              </td>
              <td class="text-right">
                <button 
                  onclick="document.getElementById('inquiry-modal-<%= account.id %>').showModal()"
                  class="btn btn-outline btn-sm reset-base"
                >
                  Manage
                </button>

                <!-- HTML5 Dialog Modal -->
                <dialog id="inquiry-modal-<%= account.id %>" class="inquiry-modal">
                  <div class="inquiry-modal-header">
                    <div>
                      <h2 class="inquiry-modal-title">Manage Inquiry</h2>
                      <p class="inquiry-modal-desc">Account: <%= account.name %> (#<%= account.id %>)</p>
                    </div>
                    <button type="button" onclick="document.getElementById('inquiry-modal-<%= account.id %>').close()" class="modal-close-btn reset-base">
                      <span class="i-lucide-x size-5 block"></span>
                    </button>
                  </div>

                  <div class="inquiry-modal-body space-y-6 text-left">
                      <% if inquiry['message'].present? %>
                        <div class="bg-muted/50 p-3 rounded-lg border border-border text-sm text-foreground">
                          <strong class="block text-xs text-muted-foreground mb-1">Message from customer:</strong>
                          <%= inquiry['message'] %>
                        </div>
                      <% end %>

                      <div class="border-t border-border pt-4">
                        <h3 class="text-sm font-medium mb-3 text-foreground">Payment Link</h3>
                        <% if inquiry['payment_link_sent_at'].present? %>
                          <div class="text-sm text-success bg-success/10 p-3 rounded-md border border-success/20">
                            Sent ($<%= inquiry['payment_link_amount'] %>/mo) by <%= inquiry['payment_link_sent_by'] %> on <%= Time.zone.parse(inquiry['payment_link_sent_at']).strftime('%d %b %Y') %>
                          </div>
                        <% else %>
                          <%= form_tag send_payment_link_super_admin_enterprise_inquiry_path(account), method: :post, class: 'space-y-3' do %>
                            <div class="flex items-center gap-3">
                              <div class="relative flex-1">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"><%= (Enterprise::Billing::EnterpriseInquiryAttributes.stored_custom_attributes(account)['billing_country'].to_s.upcase == 'IN') ? '₹' : '$' %></span>
                                <%= number_field_tag :monthly_price, contract&.negotiated_price, min: 1, step: 0.01, placeholder: 'e.g. 499', required: true, class: 'form-input !pl-7' %>
                              </div>
                              <div class="flex-1">
                                <%= select_tag :payment_provider,
                                    options_for_select(
                                      @payment_gateways.map { |gateway|
                                        ["#{Enterprise::Billing::PaymentGatewayRegistry.label_for(gateway['id'])} (#{Enterprise::Billing::PaymentGatewayRegistry.currency_for(gateway['id']).upcase})", gateway['id']]
                                      },
                                      Enterprise::Billing::PaymentGatewayRegistry.resolve_provider(country: Enterprise::Billing::EnterpriseInquiryAttributes.stored_custom_attributes(account)['billing_country'])
                                    ),
                                    class: 'form-input' %>
                              </div>
                            </div>
                            <%= submit_tag 'Send Link', class: 'btn btn-primary w-full reset-base cursor-pointer' %>
                          <% end %>
                        <% end %>
                      </div>

                      <div class="border-t border-border pt-4">
                        <h3 class="text-sm font-medium mb-3 text-foreground">Inquiry Status</h3>
                        
                        <% if inquiry['rejected_at'].present? %>
                          <div class="text-sm text-destructive bg-destructive/10 p-3 rounded-md border border-destructive/20 mb-4">
                            Rejected by <%= inquiry['rejected_by'] %> on <%= Time.zone.parse(inquiry['rejected_at']).strftime('%d %b %Y') %><br>
                            <% if inquiry['rejection_note'].present? %>
                              <span class="text-muted-foreground mt-1 block">"<%= inquiry['rejection_note'] %>"</span>
                            <% end %>
                          </div>
                        <% elsif inquiry['processed_at'].present? %>
                          <div class="text-sm text-success bg-success/10 p-3 rounded-md border border-success/20 mb-4">
                            Processed by <%= inquiry['processed_by'] %> on <%= Time.zone.parse(inquiry['processed_at']).strftime('%d %b %Y') %>
                          </div>
                        <% end %>

                        <div class="flex flex-col gap-2">
                          <% unless inquiry['processed_at'].present? || inquiry['rejected_at'].present? %>
                            <%= button_to 'Mark as Processed', mark_processed_super_admin_enterprise_inquiry_path(account), method: :post, class: 'btn btn-outline w-full reset-base' %>
                            
                            <%= form_tag reject_super_admin_enterprise_inquiry_path(account), method: :post, class: 'flex gap-2 mt-2' do %>
                              <div class="flex-1 min-w-0">
                                <%= text_field_tag :note, nil, placeholder: 'Rejection reason (optional)', class: 'form-input' %>
                              </div>
                              <%= submit_tag 'Reject', class: 'btn btn-danger reset-base cursor-pointer shrink-0' %>
                            <% end %>
                          <% end %>
                          
                          <%= button_to 'Delete Inquiry', super_admin_enterprise_inquiry_path(account), method: :delete, data: { confirm: 'Delete this inquiry? This cannot be undone.' }, class: 'btn btn-danger-soft w-full reset-base mt-4' %>
                        </div>
                      </div>
                  </div>
                </dialog>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

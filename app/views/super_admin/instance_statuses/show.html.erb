<% content_for(:title) { 'Instance Health' } %>

<div class="space-y-6">
  <div class="page-header">
    <div>
      <h1 class="page-title">Instance Health</h1>
      <p class="text-[13.5px] text-muted-foreground mt-1">Version, database, and Redis diagnostics for this installation.</p>
    </div>
  </div>

  <section class="show-details-card">
    <div class="show-details-inner">
      <% @metrics.each do |key, value| %>
        <% value_text = value.to_s.presence || '—' %>
        <% status_class = case value_text
             when 'true', 'completed' then 'status-text-active'
             when 'false', 'pending' then 'status-failed'
             end %>
        <div class="show-row">
          <div class="show-label"><%= key.to_s.humanize %></div>
          <div class="show-value font-mono break-all <%= status_class.presence || 'text-foreground' %>">
            <%= value_text %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>

<% content_for(:title) do %>
  Payment Gateways
<% end %>

<div class="space-y-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="page-title">
      Payment Gateways
    </h1>
  </div>

  <% if notice.present? %>
    <div class="mb-4 rounded-lg border border-success/20 bg-success/10 px-4 py-3 text-sm text-success">
      <%= notice %>
    </div>
  <% end %>
  <% if alert.present? %>
    <div class="mb-4 rounded-lg border border-destructive/20 bg-destructive/10 px-4 py-3 text-sm text-destructive">
      <%= alert %>
    </div>
  <% end %>

  <p class="mb-6 text-sm text-muted-foreground max-w-3xl">
    Enable or disable payment gateways for cloud billing. Search and select country codes to route checkout
    (for example, India → <code>IN</code>). Each country can only be assigned to one enabled gateway.
    Leave country codes empty to use a gateway as the default fallback for countries not matched elsewhere.
    When multiple gateways are enabled, exactly one must be left as the fallback (empty country codes).
    API keys stay in environment variables; gateways marked “Not configured” are ignored even if enabled.
  </p>

  <%= form_tag super_admin_payment_gateways_path, method: :patch do %>
    <div class="table-card mb-6">
      <table>
        <thead>
          <tr>
            <th scope="col">Gateway</th>
            <th scope="col">Enabled</th>
            <th scope="col">Country codes</th>
            <th scope="col">Currency</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @gateways.each do |gateway| %>
            <tr>
              <td class="font-medium text-foreground"><%= gateway['label'] %></td>
              <td>
                <%= hidden_field_tag "gateways[#{gateway['id']}][enabled]", '0' %>
                <%= check_box_tag "gateways[#{gateway['id']}][enabled]", '1', gateway['enabled'] != false,
                  disabled: !gateway['configured'],
                  class: 'rounded border-input text-primary focus:ring-ring' %>
              </td>
              <td>
                <div
                  class="payment-gateway-countries min-w-[18rem]"
                  data-payment-gateway-countries
                  data-gateway-id="<%= gateway['id'] %>"
                  data-gateway-label="<%= gateway['label'] %>"
                  data-initial-codes="<%= gateway['country_codes_text'] %>"
                >
                  <div class="js-country-tags flex flex-wrap gap-1 mb-2"></div>
                  <div class="relative">
                    <input
                      type="text"
                      class="js-country-search block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm text-foreground focus:border-ring"
                      placeholder="Search country to add..."
                      autocomplete="off"
                    />
                    <ul class="js-country-suggestions hidden absolute z-10 mt-1 max-h-48 w-full overflow-auto rounded-lg border border-border bg-popover shadow-lg"></ul>
                  </div>
                  <%= hidden_field_tag "gateways[#{gateway['id']}][country_codes]", gateway['country_codes_text'], class: 'js-country-codes-input' %>
                </div>
              </td>
              <td class="uppercase text-foreground font-mono"><%= gateway['currency'] %></td>
              <td>
                <% if gateway['configured'] %>
                  <span class="text-success text-sm font-medium">Ready</span>
                <% else %>
                  <span class="text-warning text-sm font-medium">Not configured (missing ENV keys)</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="rounded-xl border border-border bg-card p-4 text-xs text-muted-foreground max-w-3xl mb-6">
      <p class="font-semibold text-foreground mb-1">Adding a new gateway later</p>
      <p>
        Register the gateway in
        <code>Enterprise::Billing::PaymentGatewayRegistry::DEFINITIONS</code>
        with its label, currency, and required ENV keys. It will appear on this page automatically.
      </p>
    </div>

    <div class="flex justify-end">
      <%= submit_tag 'Save gateway settings', class: 'inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2 cursor-pointer shadow-xs' %>
    </div>
  <% end %>
</div>


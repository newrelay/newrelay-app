<% content_for(:title) do %>
  Payment Gateways
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title">
    <%= content_for(:title) %>
  </h1>
</header>

<section class="main-content__body">
  <% if notice.present? %>
    <div class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
      <%= notice %>
    </div>
  <% end %>
  <% if alert.present? %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <%= alert %>
    </div>
  <% end %>

  <p class="mb-6 text-sm text-slate-600 max-w-3xl">
    Enable or disable payment gateways for cloud billing. Search and select country codes to route checkout
    (for example, India → <code>IN</code>). Each country can only be assigned to one enabled gateway.
    Leave country codes empty to use a gateway as the default fallback for countries not matched elsewhere.
    When multiple gateways are enabled, exactly one must be left as the fallback (empty country codes).
    API keys stay in environment variables; gateways marked “Not configured” are ignored even if enabled.
  </p>

  <%= form_tag super_admin_payment_gateways_path, method: :patch do %>
    <div class="overflow-x-auto mb-6">
      <table>
        <thead>
          <tr>
            <th class="cell-label" scope="col">Gateway</th>
            <th class="cell-label" scope="col">Enabled</th>
            <th class="cell-label" scope="col">Country codes</th>
            <th class="cell-label" scope="col">Currency</th>
            <th class="cell-label" scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @gateways.each do |gateway| %>
            <tr class="js-table-row">
              <td class="cell-data font-medium text-slate-900"><%= gateway['label'] %></td>
              <td class="cell-data">
                <%= hidden_field_tag "gateways[#{gateway['id']}][enabled]", '0' %>
                <%= check_box_tag "gateways[#{gateway['id']}][enabled]", '1', gateway['enabled'] != false,
                  disabled: !gateway['configured'],
                  class: 'rounded border-slate-300 text-violet-600 focus:ring-violet-600' %>
              </td>
              <td class="cell-data">
                <div
                  class="payment-gateway-countries min-w-[18rem]"
                  data-payment-gateway-countries
                  data-gateway-id="<%= gateway['id'] %>"
                  data-gateway-label="<%= gateway['label'] %>"
                  data-initial-codes="<%= gateway['country_codes_text'] %>"
                >
                  <div class="js-country-tags flex flex-wrap gap-1 mb-2"></div>
                  <div class="relative">
                    <input
                      type="text"
                      class="js-country-search block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-violet-600 focus:ring-violet-600"
                      placeholder="Search country to add..."
                      autocomplete="off"
                    />
                    <ul class="js-country-suggestions hidden absolute z-10 mt-1 max-h-48 w-full overflow-auto rounded-lg border border-slate-200 bg-white shadow-lg"></ul>
                  </div>
                  <%= hidden_field_tag "gateways[#{gateway['id']}][country_codes]", gateway['country_codes_text'], class: 'js-country-codes-input' %>
                </div>
              </td>
              <td class="cell-data uppercase text-slate-700"><%= gateway['currency'] %></td>
              <td class="cell-data">
                <% if gateway['configured'] %>
                  <span class="text-green-700 text-sm">Ready</span>
                <% else %>
                  <span class="text-amber-700 text-sm">Not configured (missing ENV keys)</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-xs text-slate-600 max-w-3xl mb-6">
      <p class="font-semibold text-slate-800 mb-1">Adding a new gateway later</p>
      <p>
        Register the gateway in
        <code>Enterprise::Billing::PaymentGatewayRegistry::DEFINITIONS</code>
        with its label, currency, and required ENV keys. It will appear on this page automatically.
      </p>
    </div>

    <div class="flex justify-end">
      <%= submit_tag 'Save gateway settings', class: 'button' %>
    </div>
  <% end %>
</section>

<% content_for(:title) do %>
  Plan Management
<% end %>

<div class="space-y-6">
  <div class="page-header">
    <div>
      <h1 class="page-title">Plan Management</h1>
      <p class="text-[13.5px] text-muted-foreground mt-1">Configure plan pricing, resource limits, and feature availability</p>
    </div>
  </div>

  <% if notice.present? %>
    <div class="mb-4 rounded-lg border border-success/20 bg-success/10 px-4 py-3 text-sm text-success">
      <%= notice %>
    </div>
  <% end %>

  <%= form_tag super_admin_plan_management_path, method: :patch do %>
    <%# Plan pricing cards %>
    <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      <% @plans.each do |plan| %>
        <div class="rounded-xl border border-border bg-card p-5 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-semibold text-foreground"><%= plan['name'] %></h2>
            <label class="flex items-center gap-2 text-sm text-muted-foreground cursor-pointer">
              <%= hidden_field_tag "plans[#{plan['name']}][enabled]", '0' %>
              <span class="custom-checkbox">
                <%= check_box_tag "plans[#{plan['name']}][enabled]", '1', plan['enabled'] != false %>
                <span class="checkmark"></span>
              </span>
              <span>Enabled</span>
            </label>
          </div>
          <% if plan['name'].downcase == 'enterprise' %>
            <div>
              <span class="block text-xs font-medium text-muted-foreground mb-1">Price per agent</span>
              <span class="block w-full rounded-lg border border-border bg-muted/40 px-3 py-2 text-sm text-muted-foreground">Customized per account</span>
            </div>
            <p class="mt-2 text-xs text-muted-foreground">Pricing is negotiated per account - see Enterprise Inquiries and Enterprise Contracts.</p>
          <% else %>
            <%
              gateway_prices = plan['gateway_prices'] || {}
            %>
            <% Enterprise::Billing::PaymentGatewayRegistry.definitions.each do |gateway_id, definition| %>
              <%
                gw_price = gateway_prices.dig(gateway_id, 'amount') || plan['price_per_agent'] || 0
                gw_plan_id = gateway_prices.dig(gateway_id, 'price_id') || gateway_prices.dig(gateway_id, 'plan_id')
                if gateway_id == 'stripe'
                  gw_plan_id ||= plan['price_ids']&.first
                elsif gateway_id == 'razorpay'
                  gw_plan_id ||= plan['razorpay_plan_ids']&.first || plan['razorpay_plan_id']
                end
              %>
              <div class="mt-4 border-t border-border pt-4">
                <p class="text-xs font-medium text-muted-foreground mb-2"><%= definition[:label] %></p>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block text-xs font-medium text-muted-foreground mb-1">Price (<%= definition[:currency].upcase %>/mo)</label>
                    <%= number_field_tag "plans[#{plan['name']}][gateway_prices][#{gateway_id}][amount]", gw_price, min: 0, step: 0.01, class: 'form-input' %>
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-muted-foreground mb-1">Plan/Price ID</label>
                    <%= text_field_tag "plans[#{plan['name']}][gateway_prices][#{gateway_id}][plan_id]", gw_plan_id, placeholder: 'id_...', class: 'form-input' %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Resource Limits Matrix Heading %>
    <div class="mb-3">
      <h2 class="text-sm font-semibold text-foreground">Resource Limits</h2>
      <p class="text-xs text-muted-foreground mt-0.5">Define resource boundaries per subscription tier (leave blank for unlimited)</p>
    </div>

    <%# Resource Limits Table %>
    <div class="table-card mb-8">
      <table>
        <thead>
          <tr>
            <th class="w-1/3" scope="col">Resource Limit (Blank = Unlimited)</th>
            <% @plans.each do |plan| %>
              <th class="text-center" scope="col"><%= plan['name'] %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @limits.each do |limit| %>
            <tr>
              <td class="font-medium text-foreground"><%= limit['display_name'] %></td>
              <% @plans.each do |plan| %>
                <td class="text-center">
                  <% if plan['name'].downcase == 'enterprise' %>
                    <span class="text-xs text-muted-foreground">Custom</span>
                  <% else %>
                    <%
                      pfl = @plan_feature_limits[[plan['name'].downcase, limit['name']]]
                      limit_val = pfl&.limit_value
                    %>
                    <%= number_field_tag "plan_limits[#{plan['name']}][#{limit['name']}]", limit_val, min: 0, class: 'form-input text-center' %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Feature matrix heading %>
    <div class="mb-3">
      <h2 class="text-sm font-semibold text-foreground">Feature Matrix</h2>
      <p class="text-xs text-muted-foreground mt-0.5">Toggle modular platform feature availability across subscription tiers</p>
    </div>

    <%# Feature matrix table %>
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th class="w-1/3" scope="col">Feature</th>
            <% @plans.each do |plan| %>
              <th class="text-center" scope="col">
                <%= plan['name'] %>
                <% if plan['name'].downcase != 'enterprise' %>
                  <button type="button" class="btn-toggle-all mx-auto mt-1" onclick="const cbs = document.querySelectorAll('input[id^=feature_<%= plan['name'].parameterize %>_]'); const allChecked = Array.from(cbs).every(cb => cb.checked); cbs.forEach(cb => cb.checked = !allChecked); this.innerText = allChecked ? 'Select All' : 'Deselect All';">Select All</button>
                <% end %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @all_features.each do |feature| %>
            <tr>
              <td class="text-foreground"><%= feature['display_name'] %></td>
              <% @plans.each do |plan| %>
                <td class="text-center">
                  <% if plan['name'].downcase == 'enterprise' %>
                    <span class="text-xs text-muted-foreground">Custom</span>
                  <% else %>
                    <%
                      pfl = @plan_feature_limits[[plan['name'].downcase, feature['name']]]
                      checked = pfl&.enabled || false
                    %>
                    <%= hidden_field_tag "plan_features[#{plan['name']}][#{feature['name']}]", '0' %>
                    <label class="custom-checkbox mx-auto">
                      <%= check_box_tag "plan_features[#{plan['name']}][#{feature['name']}]", '1', checked, id: "feature_#{plan['name'].parameterize}_#{feature['name']}" %>
                      <span class="checkmark"></span>
                    </label>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="form-actions-bar">
      <%= submit_tag 'Save Plans', class: 'btn btn-primary reset-base cursor-pointer' %>
    </div>
  <% end %>
</div>

<% content_for(:title) { 'Settings' } %>

<div class="space-y-6">
  <header class="flex items-center justify-between pb-4 border-b border-border/40">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-foreground">Settings</h1>
      <p class="text-sm text-muted-foreground mt-1">Update your instance settings and access billing portal</p>
    </div>
  </header>

  <% if Redis::Alfred.get(Redis::Alfred::CHATWOOT_INSTALLATION_CONFIG_RESET_WARNING) %>
    <div class="flex items-start gap-2.5 rounded-lg bg-destructive/10 border border-destructive/20 p-4 text-sm text-destructive">
      <span class="i-lucide-alert-circle size-4 mt-0.5 shrink-0" aria-hidden="true"></span>
      <div>
        <strong class="font-semibold">Unauthorized premium changes detected.</strong>
        <span class="block mt-0.5">To keep using them, please upgrade your plan. Contact: <span class="font-medium">sales@dakshai.com</span></span>
      </div>
    </div>
  <% end %>

  <div class="space-y-4">
    <%# Installation Identifier %>
    <div class="rounded-xl border border-border bg-card shadow-xs overflow-hidden">
      <div class="px-6 py-4 border-b border-border/40">
        <h2 class="text-sm font-semibold text-foreground">Installation Identifier</h2>
      </div>
      <div class="px-6 py-4">
        <%= javascript_include_tag "secretField" %>
        <div data-secret-text="<%= ChatwootHub.installation_identifier %>" class="cell-data__secret-field inline-flex items-center gap-1 text-sm text-foreground font-mono">
          <span data-secret-masked="true" class="select-none"></span>
          <button type="button" onclick="toggleSecretField(event)" data-secret-toggler class="inline-flex items-center justify-center size-7 rounded-md text-muted-foreground hover:text-foreground hover:bg-muted transition-colors focus:outline-none">
            <svg width="16" height="16" class="fill-current"><use xlink:href="#eye-show" /></svg>
          </button>
          <button type="button" onclick="copySecretField(event)" data-secret-copier class="inline-flex items-center justify-center size-7 rounded-md text-muted-foreground hover:text-foreground hover:bg-muted transition-colors focus:outline-none">
            <svg width="16" height="16" class="fill-current"><use xlink:href="#icon-copy" /></svg>
          </button>
        </div>
      </div>
    </div>

    <% if ChatwootApp.enterprise? %>
      <div class="rounded-xl border border-border bg-card shadow-xs overflow-hidden">
        <div class="px-6 py-4 border-b border-border/40 flex items-center justify-between">
          <h2 class="text-sm font-semibold text-foreground">Current Plan</h2>
          <a href="<%= refresh_super_admin_settings_url %>" class="inline-flex items-center gap-1.5 text-xs font-medium text-primary hover:text-primary/80 transition-colors">
            <span class="i-lucide-refresh-cw size-3.5"></span>
            Refresh
          </a>
        </div>
        <div class="px-6 py-4 flex items-center justify-between gap-4 flex-wrap">
          <p class="text-sm text-muted-foreground"><%= SuperAdmin::FeaturesHelper.plan_details.html_safe %></p>
          <a href="<%= ChatwootHub.billing_url %>" target="_blank" rel="noopener noreferrer"
             class="inline-flex shrink-0 h-9 items-center gap-2 rounded-md border border-border bg-background px-3 py-2 text-sm font-medium text-foreground shadow-xs transition-colors hover:bg-muted">
            <span class="i-lucide-settings size-4"></span>
            Manage Billing
          </a>
        </div>
      </div>
    <% end %>

    <% if ChatwootHub.pricing_plan != 'community' && User.count > ChatwootHub.pricing_plan_quantity %>
      <div class="flex items-start gap-2.5 rounded-lg bg-destructive/10 border border-destructive/20 p-4 text-sm text-destructive">
        <span class="i-lucide-alert-circle size-4 mt-0.5 shrink-0" aria-hidden="true"></span>
        You have <%= User.count %> agents. Please add more licenses to add more users.
      </div>
    <% end %>

    <div class="rounded-xl border border-border bg-card shadow-xs overflow-hidden">
      <div class="px-6 py-4 border-b border-border/40">
        <h2 class="text-sm font-semibold text-foreground">Need Help?</h2>
        <p class="text-sm text-muted-foreground mt-0.5">Do you face any issues? We are here to help.</p>
      </div>
      <div class="px-6 py-4 flex flex-wrap items-center gap-3">
        <a href="https://discord.gg/cJXdrwS" target="_blank"
           class="inline-flex h-9 items-center gap-2 rounded-md bg-violet-600 hover:bg-violet-700 text-white px-4 py-2 text-sm font-medium shadow-xs transition-colors">
          <svg class="size-4" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M13.209 3.103c-.495-1.004-1.926-1.004-2.421 0L8.43 7.88l-5.273.766c-1.107.161-1.55 1.522-.748 2.303l3.815 3.72-.9 5.25c-.19 1.103.968 1.944 1.959 1.424l4.715-2.48 4.716 2.48c.99.52 2.148-.32 1.96-1.424l-.902-5.25 3.816-3.72c.8-.78.359-2.142-.748-2.303l-5.273-.766-2.358-4.777Z" fill="currentColor"/></svg>
          Community Support
        </a>
        <% if ChatwootHub.pricing_plan != 'community' %>
          <button class="inline-flex h-9 items-center gap-2 rounded-md border border-border bg-background hover:bg-muted px-4 py-2 text-sm font-medium text-foreground shadow-xs transition-colors" onclick="window.$chatwoot.toggle('open')">
            <span class="i-lucide-message-circle size-4"></span>
            Chat Support
          </button>
        <% end %>
      </div>
    </div>

    <div class="rounded-xl border border-border bg-card shadow-xs overflow-hidden">
      <div class="px-6 py-4 border-b border-border/40">
        <h2 class="text-sm font-semibold text-foreground">Features</h2>
      </div>
      <div class="p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% SuperAdmin::FeaturesHelper.available_features.each do |feature, attrs| %>
          <div class="group relative rounded-xl border border-border bg-background p-4 hover:bg-muted/30 transition-colors">
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center justify-center size-9 rounded-lg border border-border bg-card text-muted-foreground">
                <svg width="18" height="18"><use xlink:href="#<%= attrs[:icon] %>" /></svg>
              </div>
              <span class="<%= attrs[:enabled] ? 'bg-success/15 text-success' : 'bg-muted text-muted-foreground' %> inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium">
                <% if attrs[:enabled] %>
                  <span class="i-lucide-check size-3"></span>Active
                <% else %>
                  <span class="i-lucide-lock size-3"></span>Locked
                <% end %>
              </span>
            </div>
            <% unless attrs[:enabled] %>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity rounded-xl bg-background/80">
                <% if ChatwootApp.enterprise? %>
                  <%= render 'upgrade_button_enterprise' %>
                <% else %>
                  <%= render 'upgrade_button_community' %>
                <% end %>
              </div>
            <% end %>
            <div class="flex items-center gap-1.5 mb-1">
              <h3 class="text-sm font-medium text-foreground"><%= attrs[:name] %></h3>
              <% if attrs[:enterprise] %>
                <span class="px-1.5 py-0.5 rounded text-xs font-medium text-green-700 bg-green-100">EE</span>
              <% end %>
              <% if attrs[:config_key].present? && attrs[:enabled] %>
                <a class="inline-flex items-center justify-center size-5 rounded hover:bg-muted transition-colors" href="/super_admin/app_config?config=<%= attrs[:config_key] %>">
                  <svg width="14" height="14"><use xlink:href="#icon-gear" /></svg>
                </a>
              <% end %>
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed"><%= attrs[:description] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

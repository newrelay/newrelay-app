<%# locals: account, transactions (optional), billing_activity (optional), plan_name (optional) %>
<% billing_activity = local_assigns[:billing_activity] || [] %>
<% sub = account.subscription %>
<% plan_name = local_assigns[:plan_name].presence || sub&.plan_name.presence || account.custom_attributes['plan_name'] %>
<% billing_country = account.custom_attributes['billing_country'] %>

<section class="space-y-6">
  <div class="rounded-lg border border-slate-200 bg-white overflow-hidden">
    <div class="border-b border-slate-200 px-4 py-3">
      <h2 class="text-sm font-semibold text-slate-900">Current plan</h2>
    </div>
    <table>
      <tbody>
        <tr class="js-table-row">
          <td class="cell-label w-1/3">Account</td>
          <td class="cell-data font-semibold text-slate-800">
            #<%= account.id %> — <%= account.name %>
          </td>
        </tr>
        <tr class="js-table-row">
          <td class="cell-label">Plan</td>
          <td class="cell-data"><%= plan_name.presence || '—' %></td>
        </tr>
        <% if sub.present? %>
          <tr class="js-table-row">
            <td class="cell-label">Subscription status</td>
            <td class="cell-data"><%= sub.status %></td>
          </tr>
          <tr class="js-table-row">
            <td class="cell-label">Active</td>
            <td class="cell-data"><%= sub.active? ? 'Yes' : 'No' %></td>
          </tr>
          <tr class="js-table-row">
            <td class="cell-label">Payment provider</td>
            <td class="cell-data"><%= sub.payment_provider.to_s.capitalize %></td>
          </tr>
          <tr class="js-table-row">
            <td class="cell-label">Current period start</td>
            <td class="cell-data">
              <%= sub.current_period_start.present? ? l(sub.current_period_start, format: :long) : '—' %>
            </td>
          </tr>
          <tr class="js-table-row">
            <td class="cell-label"><%= sub.cancel_at_period_end? ? 'Access until' : 'Renews on' %></td>
            <td class="cell-data">
              <%= sub.current_period_end.present? ? l(sub.current_period_end, format: :long) : '—' %>
            </td>
          </tr>
          <% if sub.grace_period_ends_at.present? %>
            <tr class="js-table-row">
              <td class="cell-label">Payment retry by</td>
              <td class="cell-data"><%= l(sub.grace_period_ends_at, format: :long) %></td>
            </tr>
          <% end %>
          <tr class="js-table-row">
            <td class="cell-label">Cancel at period end</td>
            <td class="cell-data"><%= sub.cancel_at_period_end? ? 'Yes' : 'No' %></td>
          </tr>
        <% else %>
          <tr class="js-table-row">
            <td class="cell-label">Subscription</td>
            <td class="cell-data text-slate-500">No subscription record</td>
          </tr>
        <% end %>
        <% if billing_country.present? %>
          <tr class="js-table-row">
            <td class="cell-label">Billing country</td>
            <td class="cell-data"><%= billing_country %></td>
          </tr>
        <% end %>
        <% if account.parent.present? %>
          <tr class="js-table-row">
            <td class="cell-label">Reseller parent</td>
            <td class="cell-data">
              <%= link_to account.parent.name, account_super_admin_account_hierarchy_path(account.parent), class: 'text-violet-700 hover:underline' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if sub.present? %>
    <div class="rounded-lg border border-slate-200 bg-white overflow-hidden">
      <div class="border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">Payment gateway IDs</h2>
      </div>
      <table>
        <tbody>
          <% if sub.payment_provider == 'stripe' %>
            <tr class="js-table-row">
              <td class="cell-label w-1/3">Stripe customer</td>
              <td class="cell-data font-mono text-sm"><%= sub.stripe_customer_id.presence || account.custom_attributes['stripe_customer_id'].presence || '—' %></td>
            </tr>
            <tr class="js-table-row">
              <td class="cell-label">Stripe subscription</td>
              <td class="cell-data font-mono text-sm"><%= sub.stripe_subscription_id.presence || '—' %></td>
            </tr>
          <% else %>
            <tr class="js-table-row">
              <td class="cell-label w-1/3">Razorpay customer</td>
              <td class="cell-data font-mono text-sm"><%= sub.razorpay_customer_id.presence || account.custom_attributes['razorpay_customer_id'].presence || '—' %></td>
            </tr>
            <tr class="js-table-row">
              <td class="cell-label">Razorpay subscription</td>
              <td class="cell-data font-mono text-sm"><%= sub.razorpay_subscription_id.presence || '—' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="rounded-lg border border-slate-200 bg-white overflow-hidden">
    <div class="border-b border-slate-200 px-4 py-3 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-slate-900">Billing activity</h2>
      <span class="text-xs text-slate-500"><%= pluralize(billing_activity.size, 'record') %></span>
    </div>
    <% if billing_activity.empty? %>
      <p class="px-4 py-6 text-sm text-slate-500">No billing activity recorded yet.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table>
          <thead>
            <tr>
              <th class="cell-label" scope="col">Date</th>
              <th class="cell-label" scope="col">User</th>
              <th class="cell-label" scope="col">Action</th>
              <th class="cell-label" scope="col">Status</th>
              <th class="cell-label" scope="col">Provider</th>
              <th class="cell-label" scope="col">Message</th>
              <th class="cell-label" scope="col">Details</th>
            </tr>
          </thead>
          <tbody>
            <% billing_activity.each do |log| %>
              <tr class="js-table-row">
                <td class="cell-data whitespace-nowrap"><%= l(log.created_at, format: :long) %></td>
                <td class="cell-data"><%= log.user&.email.presence || '—' %></td>
                <td class="cell-data"><%= log.action %></td>
                <td class="cell-data">
                  <span class="<%= log.success? ? 'text-green-700' : 'text-red-700' %>">
                    <%= log.status.titleize %>
                  </span>
                </td>
                <td class="cell-data"><%= log.payment_provider.to_s.capitalize.presence || '—' %></td>
                <td class="cell-data"><%= log.message %></td>
                <td class="cell-data">
                  <%= link_to 'View', super_admin_billing_activity_log_path(log), class: 'text-violet-700 hover:underline' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>

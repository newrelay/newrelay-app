<%# locals: account, transactions (optional), billing_activity (optional), plan_name (optional) %>
<% billing_activity = local_assigns[:billing_activity] || [] %>
<% sub = account.subscription %>
<% plan_name = local_assigns[:plan_name].presence || sub&.plan_name.presence || account.custom_attributes['plan_name'] %>
<% billing_country = account.custom_attributes['billing_country'] %>

<section class="space-y-6">
  <section class="show-details-card">
    <div class="show-details-inner">
      <h3 class="show-section-title">Current plan</h3>
      <div class="show-row">
        <div class="show-label">Account</div>
        <div class="show-value font-semibold">#<%= account.id %> — <%= account.name %></div>
      </div>
      <div class="show-row">
        <div class="show-label">Plan</div>
        <div class="show-value"><%= plan_name.presence || '—' %></div>
      </div>
      <% if sub.present? %>
        <div class="show-row">
          <div class="show-label">Subscription status</div>
          <div class="show-value">
            <span class="<%= sub.status.to_s == 'active' ? 'status-text-active' : 'text-foreground' %>"><%= sub.status.presence || '—' %></span>
          </div>
        </div>
        <div class="show-row">
          <div class="show-label">Active</div>
          <div class="show-value"><%= sub.active? ? 'Yes' : 'No' %></div>
        </div>
        <div class="show-row">
          <div class="show-label">Payment provider</div>
          <div class="show-value"><%= sub.payment_provider.to_s.capitalize.presence || '—' %></div>
        </div>
        <div class="show-row">
          <div class="show-label">Current period start</div>
          <div class="show-value"><%= sub.current_period_start.present? ? l(sub.current_period_start, format: :long) : '—' %></div>
        </div>
        <div class="show-row">
          <div class="show-label"><%= sub.cancel_at_period_end? ? 'Access until' : 'Renews on' %></div>
          <div class="show-value"><%= sub.current_period_end.present? ? l(sub.current_period_end, format: :long) : '—' %></div>
        </div>
        <% if sub.grace_period_ends_at.present? %>
          <div class="show-row">
            <div class="show-label">Payment retry by</div>
            <div class="show-value"><%= l(sub.grace_period_ends_at, format: :long) %></div>
          </div>
        <% end %>
        <div class="show-row">
          <div class="show-label">Cancel at period end</div>
          <div class="show-value"><%= sub.cancel_at_period_end? ? 'Yes' : 'No' %></div>
        </div>
      <% else %>
        <div class="show-row">
          <div class="show-label">Subscription</div>
          <div class="show-value text-muted-foreground">No subscription record</div>
        </div>
      <% end %>
      <% if billing_country.present? %>
        <div class="show-row">
          <div class="show-label">Billing country</div>
          <div class="show-value"><%= billing_country %></div>
        </div>
      <% end %>
      <% if account.parent.present? %>
        <div class="show-row">
          <div class="show-label">Reseller parent</div>
          <div class="show-value">
            <%= link_to account.parent.name, account_super_admin_account_hierarchy_path(account.parent), class: 'text-primary hover:underline' %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <% if sub.present? %>
    <section class="show-details-card">
      <div class="show-details-inner">
        <h3 class="show-section-title">Payment gateway IDs</h3>
        <% if sub.payment_provider == 'stripe' %>
          <div class="show-row">
            <div class="show-label">Stripe customer</div>
            <div class="show-value font-mono text-sm"><%= sub.stripe_customer_id.presence || account.custom_attributes['stripe_customer_id'].presence || '—' %></div>
          </div>
          <div class="show-row">
            <div class="show-label">Stripe subscription</div>
            <div class="show-value font-mono text-sm"><%= sub.stripe_subscription_id.presence || '—' %></div>
          </div>
        <% else %>
          <div class="show-row">
            <div class="show-label">Razorpay customer</div>
            <div class="show-value font-mono text-sm"><%= sub.razorpay_customer_id.presence || account.custom_attributes['razorpay_customer_id'].presence || '—' %></div>
          </div>
          <div class="show-row">
            <div class="show-label">Razorpay subscription</div>
            <div class="show-value font-mono text-sm"><%= sub.razorpay_subscription_id.presence || '—' %></div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="show-sub-card overflow-hidden p-0">
    <div class="show-sub-header px-6 pt-5 mx-6">
      <h2 class="show-sub-title">Billing activity</h2>
      <span class="text-xs text-muted-foreground"><%= pluralize(billing_activity.size, 'record') %></span>
    </div>
    <% if billing_activity.empty? %>
      <p class="px-6 pb-5 text-sm text-muted-foreground">No billing activity recorded yet.</p>
    <% else %>
      <div class="px-3 pb-3">
        <div class="table-card">
          <table>
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">User</th>
                <th scope="col">Action</th>
                <th scope="col">Status</th>
                <th scope="col">Provider</th>
                <th scope="col">Message</th>
                <th scope="col">Details</th>
              </tr>
            </thead>
            <tbody>
              <% billing_activity.each do |log| %>
                <tr>
                  <td class="whitespace-nowrap"><%= l(log.created_at, format: :long) %></td>
                  <td><%= log.user&.email.presence || '—' %></td>
                  <td><%= log.action %></td>
                  <td>
                    <span class="<%= log.success? ? 'status-text-active' : 'text-destructive' %>">
                      <%= log.status.titleize %>
                    </span>
                  </td>
                  <td><%= log.payment_provider.to_s.capitalize.presence || '—' %></td>
                  <td><%= log.message.presence || '—' %></td>
                  <td>
                    <%= link_to 'View', super_admin_billing_activity_log_path(log), class: 'text-primary hover:underline' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </section>
</section>

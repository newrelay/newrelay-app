<div class="rounded-md border border-border bg-card text-card-foreground shadow-sm overflow-hidden">
  <table class="w-full text-sm text-left" aria-labelledby="<%= table_title %>">
    <thead class="bg-muted/50 border-b border-border text-muted-foreground font-medium">
      <tr>
      <% collection_presenter.attribute_types.each do |attr_name, attr_type| %>
        <th class="px-4 py-3 align-middle font-medium cell-label
        cell-label--<%= attr_type.html_class %>
        cell-label--<%= collection_presenter.ordered_html_class(attr_name) %>"
        scope="col"
        role="columnheader"
        aria-sort="<%= sort_order(collection_presenter.ordered_html_class(attr_name)) %>">
        <%= link_to(sanitized_order_params(page, collection_field_name).merge(
          collection_presenter.order_params_for(attr_name, key: collection_field_name)
        )) do %>
        <%= t(
          "helpers.label.#{collection_presenter.resource_name}.#{attr_name}",
          default: attr_name.to_s,
        ).titleize %>
            <% if collection_presenter.ordered_by?(attr_name) %>
              <span class="cell-label__sort-indicator cell-label__sort-indicator--<%= collection_presenter.ordered_html_class(attr_name) %>">
                <svg aria-hidden="true">
                  <use xlink:href="#icon-up-caret" />
                </svg>
              </span>
            <% end %>
          <% end %>
        </th>
      <% end %>
      <% has_actions = existing_action?(collection_presenter.resource_name, :edit) || existing_action?(collection_presenter.resource_name, :destroy) %>
      <% if has_actions %>
        <th scope="col" class="px-4 py-3 align-middle font-medium text-right">
          <span class="sr-only">Actions</span>
        </th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <% resources.each do |resource| %>
      <tr class="js-table-row border-b border-border last:border-0 hover:bg-muted/50 transition-colors"
          tabindex="0"
          <% if existing_action? collection_presenter.resource_name, :show %>
            <%= %(role=link data-url=#{polymorphic_path([namespace, resource.becomes(User)])}) %>
          <% end %>
          >
        <% collection_presenter.attributes_for(resource).each do |attribute| %>
          <td class="px-4 py-3 align-middle cell-data cell-data--<%= attribute.html_class %>">
            <% if authorized_action? resource, :show -%>
              <a href="<%= polymorphic_path([namespace, resource.becomes(User)]) -%>"
                 class="action-show"
                 >
                <%= render_field attribute %>
              </a>
            <% end -%>
          </td>
        <% end %>

        <% has_actions = existing_action?(collection_presenter.resource_name, :edit) || existing_action?(collection_presenter.resource_name, :destroy) %>
        <% if has_actions %>
          <td class="px-4 py-3 align-middle text-right">
            <div class="flex items-center justify-end gap-1">
              <% if existing_action? collection_presenter.resource_name, :edit %>
                <%= link_to(
                  [:edit, namespace, resource.becomes(User)],
                  class: "text-muted-foreground hover:text-primary transition-colors inline-flex p-1.5 rounded-md hover:bg-primary/10",
                  title: t("administrate.actions.edit")
                ) do %>
                  <span class="i-lucide-pen-line size-4 block"></span>
                <% end if authorized_action? resource, :edit %>
              <% end %>

              <% if existing_action? collection_presenter.resource_name, :destroy %>
                <%= link_to(
                  [namespace, collection_presenter.resource_name == 'account_user' ? resource : resource.becomes(User)],
                  class: "text-muted-foreground hover:text-destructive transition-colors inline-flex p-1.5 rounded-md hover:bg-destructive/10",
                  method: :delete,
                  data: { confirm: t("administrate.actions.confirm") },
                  title: t("administrate.actions.destroy")
                ) do %>
                  <span class="i-lucide-trash-2 size-4 block"></span>
                <% end if authorized_action? resource, :destroy %>
              <% end %>
            </div>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
  </table>
</div>

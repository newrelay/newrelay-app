<section class="show-sub-card">
  <div class="show-sub-header">
    <div>
      <h3 class="show-sub-title">User Impersonation</h3>
      <p class="show-sub-subtitle">Sign in to the user's dashboard as <%= page.resource.name %> (<%= page.resource.email %>).</p>
    </div>
  </div>
  <div class="rounded-lg border border-destructive/20 bg-destructive/10 p-4 mb-4">
    <p class="text-[13.5px] font-medium text-destructive">Caution: Any actions executed after impersonating will be logged as if performed directly by <%= page.resource.name %>.</p>
  </div>
  <a class="btn btn-danger-soft" target="_blank" rel="noopener noreferrer" href="<%= page.resource.generate_sso_link_with_impersonation %>">
    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
    <span>Impersonate User</span>
  </a>
</section>

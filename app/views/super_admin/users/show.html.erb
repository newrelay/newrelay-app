<% content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) } %>

<div class="space-y-6">
  <div class="page-header">
    <%= link_to super_admin_users_path, class: "btn btn-outline" do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back</span>
    <% end %>
    <h1 class="page-title">
      <%= content_for(:title) %>
    </h1>
    <% if authorized_action?(page.resource, :edit) %>
      <div class="ml-auto">
        <%= link_to [:edit, namespace, page.resource.becomes(User)], class: "btn btn-primary" do %>
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
          <span>Edit User</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <section class="show-details-card">
    <div class="show-details-inner">
      <% page.attributes.each do |title, attributes| %>
        <% if title.present? %>
          <h3 class="show-section-title">
            <%= t "helpers.label.#{page.resource_name}.#{title}", default: title %>
          </h3>
        <% end %>

        <% attributes.each do |attribute| %>
          <div class="show-row">
            <div class="show-label" id="<%= attribute.name %>">
              <%= t(
                "helpers.label.#{resource_name}.#{attribute.name}",
                default: page.resource.class.human_attribute_name(attribute.name),
              ) %>
            </div>
            <div class="show-value attribute-data attribute-data--<%=attribute.html_class%>">
              <% if attribute.name.to_s == 'access_token' %>
                <% token = page.resource.access_token&.token %>
                <% if token.present? %>
                  <%= javascript_include_tag 'secretField' %>
                  <div data-secret-text="<%= token %>" class="cell-data__secret-field inline-flex items-center gap-1 text-sm text-foreground font-mono">
                    <span data-secret-masked="true" class="select-none"></span>
                    <button type="button" onclick="toggleSecretField(event)" data-secret-toggler class="inline-flex items-center justify-center size-7 rounded-md text-muted-foreground hover:text-foreground hover:bg-muted transition-colors focus:outline-none">
                      <svg width="16" height="16" class="fill-current"><use xlink:href="#eye-show" /></svg>
                    </button>
                    <button type="button" onclick="copySecretField(event)" data-secret-copier class="inline-flex items-center justify-center size-7 rounded-md text-muted-foreground hover:text-foreground hover:bg-muted transition-colors focus:outline-none">
                      <svg width="16" height="16" class="fill-current"><use xlink:href="#icon-copy" /></svg>
                    </button>
                  </div>
                <% elsif super_admin_blank_value?(attribute.data) %>
                  <span class="text-muted-foreground">—</span>
                <% else %>
                  <%= render_field attribute, page: page %>
                <% end %>
              <% elsif super_admin_blank_value?(attribute.data) %>
                <span class="text-muted-foreground">—</span>
              <% else %>
                <%= render_field attribute, page: page %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <div class="show-row">
        <div class="show-label" id="mfa_enabled">MFA</div>
        <div class="show-value">
          <% mfa_enabled = page.resource.mfa_enabled? %>
          <span class="<%= mfa_enabled ? 'status-text-active' : 'text-muted-foreground' %> font-medium">
            <%= mfa_enabled ? 'Enabled' : 'Disabled' %>
          </span>
        </div>
      </div>
    </div>
  </section>

  <%= render 'super_admin/shared/account_user_form', page: page, namespace: namespace, resource_type: 'user' %>

  <%= render partial: "impersonate", locals: {page: page} %>
</div>

<% regular_features, premium_features = SuperAdmin::AccountFeaturesHelper.partition_features(field.data || {}) %>
<% premium_disabled = ChatwootHub.pricing_plan == 'community' %>

<div class="field-unit field-unit--wide">
  <% if regular_features.any? %>
    <div class="feature-section-header">
      <span class="feature-section-title">Basic Features</span>
      <button type="button" class="btn-toggle-all" data-toggle-target="basic" onclick="toggleAllFeatures('.basic-feature-checkbox', this)">
        Select All
      </button>
    </div>
    <div class="feature-flags-grid">
      <% regular_features.each do |key_array, enabled| %>
        <% feature_key, display_name = key_array %>
        <label class="feature-flag-card">
          <div class="feature-flag-icon-wrap">
            <%= super_admin_feature_icon(feature_key) %>
          </div>
          <span class="feature-flag-name"><%= display_name %></span>
          <%= check_box 'enabled_features', "feature_#{feature_key}", { checked: enabled, class: 'feature-flag-checkbox basic-feature-checkbox' }, true, false %>
        </label>
      <% end %>
    </div>
  <% end %>

  <% if premium_features.any? %>
    <div class="feature-section-header">
      <span class="feature-section-title premium">
        <span class="premium-star">*</span> Premium Features
      </span>
      <button type="button" class="btn-toggle-all" data-toggle-target="premium" onclick="toggleAllFeatures('.premium-feature-checkbox', this)">
        Select All
      </button>
    </div>
    <div class="feature-flags-grid">
      <% premium_features.each do |key_array, enabled| %>
        <% feature_key, display_name = key_array %>
        <label class="feature-flag-card is-premium">
          <div class="feature-flag-icon-wrap">
            <%= super_admin_feature_icon(feature_key) %>
          </div>
          <span class="feature-flag-name"><%= display_name %></span>
          <%= check_box 'enabled_features', "feature_#{feature_key}", { checked: enabled, disabled: premium_disabled, class: 'feature-flag-checkbox premium-feature-checkbox' }, true, false %>
        </label>
      <% end %>
    </div>
  <% end %>
</div>

<script>
  (function() {
    window.toggleAllFeatures = function(selector, button) {
      const checkboxes = document.querySelectorAll(selector);
      const anyUnchecked = Array.from(checkboxes).some(cb => !cb.checked && !cb.disabled);
      checkboxes.forEach(cb => {
        if (!cb.disabled) {
          cb.checked = anyUnchecked;
          cb.dispatchEvent(new Event('change'));
        }
      });
      window.updateToggleButtonText(selector, button);
    };

    window.updateToggleButtonText = function(selector, button) {
      const checkboxes = document.querySelectorAll(selector);
      const anyUnchecked = Array.from(checkboxes).some(cb => !cb.checked && !cb.disabled);
      button.textContent = anyUnchecked ? 'Select All' : 'Deselect All';
    };

    const initSection = (btnSelector, checkboxSelector) => {
      const btn = document.querySelector(btnSelector);
      if (!btn) return;
      window.updateToggleButtonText(checkboxSelector, btn);

      document.querySelectorAll(checkboxSelector).forEach(cb => {
        cb.addEventListener('change', () => {
          window.updateToggleButtonText(checkboxSelector, btn);
        });
      });
    };

    initSection('[data-toggle-target="basic"]', '.basic-feature-checkbox');
    initSection('[data-toggle-target="premium"]', '.premium-feature-checkbox');
  })();
</script>

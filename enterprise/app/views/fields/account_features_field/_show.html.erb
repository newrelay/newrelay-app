<% regular_features, premium_features = SuperAdmin::AccountFeaturesHelper.partition_features(field.data || {}) %>

<div class="w-full">
  <% if regular_features.any? %>
    <div class="feature-section-header">
      <span class="feature-section-title">Basic Features</span>
    </div>
    <div class="feature-flags-grid">
      <% regular_features.each do |key_array, enabled| %>
        <% _feature_key, display_name = key_array %>
        <div class="feature-flag-card is-read-only <%= 'is-enabled' if enabled %>">
          <div class="feature-flag-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <span class="feature-flag-name"><%= display_name %></span>
          <span class="feature-flag-check-badge <%= 'inactive' unless enabled %>">
            <% if enabled %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <% else %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            <% end %>
          </span>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if premium_features.any? %>
    <div class="feature-section-header">
      <span class="feature-section-title premium">
        <span class="premium-star">*</span> Premium Features
      </span>
    </div>
    <div class="feature-flags-grid">
      <% premium_features.each do |key_array, enabled| %>
        <% _feature_key, display_name = key_array %>
        <div class="feature-flag-card is-read-only is-premium <%= enabled ? 'is-enabled' : 'is-disabled' %>">
          <div class="feature-flag-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <span class="feature-flag-name"><%= display_name %></span>
          <span class="feature-flag-check-badge <%= 'inactive' unless enabled %>">
            <% if enabled %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <% else %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            <% end %>
          </span>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">
  <div class="limits-form-stack">
    <% JSON.parse(field.to_s).each do |key, val| %>
      <div class="limit-field-group">
        <label class="limit-field-label" for="account_limits_<%= key %>"><%= key %></label>
        <%= number_field "account[limits]", key, value: val, id: "account_limits_#{key}", class: "form-input" %>
      </div>
    <% end %>
  </div>
</div>

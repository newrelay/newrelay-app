<%
  selected_features = field.selected_features
  all_feature_display_names = SuperAdmin::AccountFeaturesHelper.feature_display_names
%>

<div class="w-full">
  <div class="feature-section-header">
    <span class="feature-section-title">Manually managed features</span>
  </div>
  <p class="feature-flags-helper">Features that remain enabled even when account plan is downgraded</p>

  <% if selected_features.present? %>
    <div class="feature-flags-grid">
      <% selected_features.each do |feature| %>
        <div class="feature-flag-card is-read-only is-enabled">
          <div class="feature-flag-icon-wrap">
            <%= super_admin_feature_icon(feature) %>
          </div>
          <span class="feature-flag-name"><%= all_feature_display_names[feature] || feature.humanize %></span>
          <span class="feature-flag-check-badge">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-[13.5px] text-muted-foreground">No manually managed features configured</p>
  <% end %>
</div>

<% content_for(:title) { "Billing — #{@account.name}" } %>

<div class="space-y-6">
  <div class="page-header">
    <%= link_to super_admin_account_hierarchy_path, class: 'btn btn-outline' do %>
      <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back to hierarchy</span>
    <% end %>
    <h1 class="page-title"><%= content_for(:title) %></h1>
    <div class="page-actions">
      <%= link_to 'Open account', super_admin_account_path(@account), class: 'btn btn-primary' %>
    </div>
  </div>

  <%= render partial: 'super_admin/shared/account_billing_detail',
             locals: { account: @account, billing_activity: @billing_activity, plan_name: @plan_name } %>
</div>

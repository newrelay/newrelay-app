<% content_for(:title) { 'Account Hierarchy' } %>

<div class="space-y-6">
  <div class="page-header flex items-center justify-between gap-4 flex-wrap mb-2">
    <div>
      <h1 class="page-title">Account Hierarchy</h1>
      <p class="text-sm text-muted-foreground mt-1">Parent organizations and linked sub-accounts</p>
    </div>
    <div class="table-search-wrap relative">
      <svg class="size-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.34-4.34"/></svg>
      <input id="hierarchySearch" type="search" placeholder="Search accounts" class="table-search h-9 w-64 rounded-md border border-input bg-background pl-9 pr-3 text-sm text-foreground shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
    </div>
  </div>

  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-card-inner">
        <div class="stat-card-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/></svg>
        </div>
        <div class="stat-card-body">
          <div class="stat-card-val"><%= @parent_count %></div>
          <div class="stat-card-label">Parent Organizations</div>
        </div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-card-inner">
        <div class="stat-card-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="stat-card-body">
          <div class="stat-card-val"><%= @child_count %></div>
          <div class="stat-card-label">Linked Sub-Accounts</div>
        </div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-card-inner">
        <div class="stat-card-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <div class="stat-card-body">
          <div class="stat-card-val"><%= @agent_count %></div>
          <div class="stat-card-label">Total Agents</div>
        </div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-card-inner">
        <div class="stat-card-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <div class="stat-card-body">
          <div class="stat-card-val"><%= @coverage_percent %>%</div>
          <div class="stat-card-label">Hierarchy Coverage</div>
        </div>
      </div>
    </div>
  </div>

  <% if @resellers.empty? %>
    <div class="empty-table-state rounded-xl border border-border bg-card">
      <p class="text-sm text-muted-foreground">No reseller accounts found.</p>
    </div>
  <% else %>
    <div class="hierarchy-container">
      <% @resellers.each do |reseller| %>
        <%
          plan_name = reseller.subscription&.plan_name.presence || reseller.custom_attributes['plan_name'].presence || '—'
          search_text = ([reseller.name, *reseller.children.map(&:name)].join(' ')).downcase
        %>
        <div class="space-y-3" data-hierarchy-group data-search-text="<%= search_text %>">
          <div class="hierarchy-node-card">
            <div class="flex items-center gap-3 min-w-0">
              <span class="table-avatar shrink-0 flex items-center justify-center size-9 rounded-full bg-primary/10 text-primary text-sm font-semibold"><%= reseller.name.to_s.first&.upcase %></span>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-foreground truncate">#<%= reseller.id %> <%= reseller.name %> <span class="font-normal text-muted-foreground">Parent Organization</span></p>
                <p class="text-xs text-muted-foreground mt-0.5">Locale: <%= reseller.locale %> • Subscribed: <%= plan_name %> • <%= pluralize(reseller.children.size, 'Sub-tenant') %></p>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= link_to 'Billing', account_super_admin_account_hierarchy_path(reseller), class: 'inline-flex h-8 items-center rounded-md px-3 text-xs font-medium text-primary hover:underline' %>
              <%= link_to 'View Account', super_admin_account_path(reseller), class: 'inline-flex h-8 items-center rounded-md border border-input bg-background px-3 text-xs font-medium text-foreground hover:bg-accent hover:border-ring transition-colors' %>
            </div>
          </div>

          <% if reseller.children.any? %>
            <div class="hierarchy-children">
              <% reseller.children.sort_by(&:name).each do |child| %>
                <% child_status = child.status.to_s %>
                <div class="hierarchy-node-card">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="shrink-0 inline-flex items-center justify-center h-7 min-w-7 px-1.5 rounded-md bg-accent text-primary text-[11px] font-semibold"><%= child.locale.to_s.upcase.presence || '—' %></span>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-foreground truncate">#<%= child.id %> <%= child.name %></p>
                      <p class="text-xs text-muted-foreground mt-0.5">
                        <%= pluralize(@user_counts[child.id] || 0, 'User') %>
                        • <%= pluralize(@conversation_counts[child.id] || 0, 'Conversation') %>
                        • <span class="<%= child_status == 'active' ? 'status-text-active' : 'text-muted-foreground' %>"><%= child_status %></span>
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <%= link_to 'Billing', account_super_admin_account_hierarchy_path(child), class: 'inline-flex h-8 items-center rounded-md px-3 text-xs font-medium text-primary hover:underline' %>
                    <%= link_to 'View Account', super_admin_account_path(child), class: 'inline-flex h-8 items-center rounded-md border border-input bg-background px-3 text-xs font-medium text-foreground hover:bg-accent hover:border-ring transition-colors' %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('hierarchySearch');
    if (!input) return;
    input.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      document.querySelectorAll('[data-hierarchy-group]').forEach(group => {
        const haystack = group.dataset.searchText || '';
        group.hidden = query.length > 0 && !haystack.includes(query);
      });
    });
  });
</script>
